Notify about performed plugin updates:
: <?=sm_yn($sm,'CHECK_PLUGIN_UPDATED')?>

<div class="srvmon-sec">VMs</div>

Check VMs:
: <?=sm_yn($sm,'CHECK_VMS')?>

Watched VMs:
: <input type="text" name="VM_WATCH" value="<?=sm_v($sm,'VM_WATCH')?>" style="width:30em" placeholder="* or names, comma-separated">

<div class="srvmon-sec">System and UPS</div>

Check system (CPU, RAM, reboot):
: <?=sm_yn($sm,'CHECK_SYSTEM')?>

CPU load warning (% of cores):
: <input type="number" name="CPU_LOAD_WARN" min="1" value="<?=sm_v($sm,'CPU_LOAD_WARN')?>" style="width:6em">

RAM usage warning (%):
: <input type="number" name="RAM_WARN" min="1" max="100" value="<?=sm_v($sm,'RAM_WARN')?>" style="width:6em">

Check UPS (apcupsd):
: <?=sm_yn($sm,'CHECK_UPS')?>

<div class="srvmon-sec">TLS certificates<small>checked at most once per hour</small></div>

Check certificates:
: <?=sm_yn($sm,'CHECK_CERTS')?>

Certificate directories (comma-separated):
: <input type="text" name="CERT_DIRS" value="<?=sm_v($sm,'CERT_DIRS')?>" style="width:30em" placeholder="/mnt/user/appdata/NginxProxyManager/letsencrypt/live">

Hosts to check live (comma-separated):
: <input type="text" name="CERT_HOSTS" value="<?=sm_v($sm,'CERT_HOSTS')?>" style="width:30em" placeholder="cloud.example.com@192.168.1.10:443">

Expiry warning / critical (days before):
: <input type="number" name="CERT_WARN_DAYS" min="1" value="<?=sm_v($sm,'CERT_WARN_DAYS')?>" style="width:6em"> <input type="number" name="CERT_CRIT_DAYS" min="0" value="<?=sm_v($sm,'CERT_CRIT_DAYS')?>" style="width:6em">

Verify trust chain and hostname:
: <?=sm_yn($sm,'CERT_VERIFY')?>

Ignored domains (comma-separated):
: <input type="text" name="CERT_IGNORE" value="<?=sm_v($sm,'CERT_IGNORE')?>" style="width:30em">

<div class="srvmon-sec">External checks<small>reachability from the internet via UptimeRobot</small></div>

Check reachability from the internet:
: <?=sm_yn($sm,'CHECK_EXTERNAL')?>

UptimeRobot API key (main key, secret):
: <input type="password" name="UPTIMEROBOT_KEY" value="<?=sm_v($sm,'UPTIMEROBOT_KEY')?>" style="width:30em" autocomplete="off">

Services (comma-separated):
: <input type="text" name="EXT_MONITORS" value="<?=sm_v($sm,'EXT_MONITORS')?>" style="width:30em" placeholder="nextcloud:https://cloud.example.com@192.168.1.10:4443">

<div class="srvmon-sec">Additional notification channels<small>in addition to Unraid's notifications</small></div>

Webhook URL (e.g. Home Assistant):
: <input type="text" name="WEBHOOK_URL" value="<?=sm_v($sm,'WEBHOOK_URL')?>" style="width:30em" placeholder="http://192.168.1.20:8123/api/webhook/srvmon-...">

Send webhook for:
: <?=sm_lvl($sm,'WEBHOOK_LEVEL')?>

Webhook language:
: <?=sm_langsel($sm,'WEBHOOK_LANG')?>

Heartbeat URL (external outage monitoring):
: <input type="text" name="HEARTBEAT_URL" value="<?=sm_v($sm,'HEARTBEAT_URL')?>" style="width:30em" placeholder="https://hc-ping.com/...">

<div class="srvmon-sec"></div>

&nbsp;
: <input type="submit" value="Apply"><input type="button" value="Done" onclick="done()">
</form>
]]></INLINE>
</FILE>

<FILE Name="&emhttp;/SrvmonStatus.page">
<INLINE><![CDATA[Menu="Utilities"
Title="Server Monitor Status"
Icon="heartbeat"
Markdown="false"
---
<style>
.smd{--ok:#3b8c2a;--warn:#c98a00;--crit:#c0392b;--line:rgba(127,127,127,.25);--soft:rgba(127,127,127,.10);max-width:1400px}
.smd-head{display:flex;flex-wrap:wrap;gap:.5em 1.5em;align-items:center;margin:0 0 1em}
.smd-badge{display:inline-block;padding:.15em .6em;border-radius:4px;font-weight:bold;color:#fff}
.smd-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:1em}
.smd-card{border:1px solid var(--line);border-radius:6px;padding:.8em 1em;min-width:0}
.smd-card h3{margin:0 0 .6em;font-size:1.05em}
.smd-wide{grid-column:1/-1}
.smd-row{display:flex;justify-content:space-between;gap:1em;margin:.25em 0}
.smd-bar{height:8px;background:var(--soft);border-radius:4px;overflow:hidden;margin:.2em 0 .6em}
.smd-bar>span{display:block;height:100%}
.smd-scroll{overflow-x:auto}
.smd table{width:100%;border-collapse:collapse}
.smd th,.smd td{text-align:left;padding:.3em .5em;border-bottom:1px solid var(--line);white-space:nowrap}
.smd-chip{display:inline-block;padding:.05em .5em;border-radius:3px;font-size:.9em;border:1px solid currentColor}
.smd-issue{border-left:4px solid;padding:.3em .7em;margin:.4em 0;background:var(--soft)}
.smd-muted{opacity:.7;font-size:.9em}
.smd-ok{color:var(--ok)}.smd-warn{color:var(--warn)}.smd-crit{color:var(--crit)}
</style>
<div class="smd" id="smd">
<div class="smd-head"><span id="smd-summary">Loading data …</span><span class="smd-muted" id="smd-times"></span><span class="smd-muted">Refreshes every 30 s</span></div>
<div class="smd-grid" id="smd-grid"></div>
</div>
<script>
(function(){
  var URL='/plugins/srvmon/include/data.php', REFRESH=30000;
  function esc(s){return String(s==null?'':s).replace(/[&<>"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];});}
  function fmtB(b){if(b==null)return '–';var u=['B','KB','MB','GB','TB','PB'],i=0;b=Number(b);while(b>=1024&&i<u.length-1){b/=1024;i++;}return b.toFixed(1)+' '+u[i];}
  function fmtT(ts){if(!ts)return '–';var d=new Date(ts*1000);return d.toLocaleString('en-GB');}
  function fmtUp(s){var d=Math.floor(s/86400),h=Math.floor(s%86400/3600),m=Math.floor(s%3600/60);return (d?d+' d ':'')+h+' h '+m+' min';}
  function lvlCls(v,w,c){if(v==null)return '';return v>=c?'smd-crit':(v>=w?'smd-warn':'smd-ok');}
  function col(cls){return cls==='smd-crit'?'var(--crit)':(cls==='smd-warn'?'var(--warn)':'var(--ok)');}
  function bar(pct,cls){var p=Math.max(0,Math.min(100,pct||0));return '<div class="smd-bar"><span style="width:'+p+'%;background:'+col(cls)+'"></span></div>';}
  function card(title,body,wide){return '<div class="smd-card'+(wide?' smd-wide':'')+'"><h3>'+esc(title)+'</h3>'+body+'</div>';}
  function chip(text,cls){return '<span class="smd-chip '+cls+'">'+esc(text)+'</span>';}
  function n1(v){return v==null?'–':Number(v).toFixed(1);}
  function render(d){
    var t=d.thresholds, h='';
    var crit=d.issues.filter(function(i){return i.level==='alert';}).length, warn=d.issues.length-crit;
    var sum=crit?'<span class="smd-badge" style="background:var(--crit)">'+crit+' critical</span> ':'';
    sum+=warn?'<span class="smd-badge" style="background:var(--warn)">'+warn+' warning'+(warn>1?'s':'')+'</span>':'';
    if(!crit&&!warn)sum='<span class="smd-badge" style="background:var(--ok)">All good</span>';
    document.getElementById('smd-summary').innerHTML=sum;
    document.getElementById('smd-times').textContent='Live data: '+fmtT(d.time)+' · Last check: '+fmtT(d.lastrun);
    if(d.issues.length){
      var b='';d.issues.forEach(function(i){var c=i.level==='alert'?'smd-crit':'smd-warn';
        b+='<div class="smd-issue" style="border-color:'+col(c)+'"><b class="'+c+'">'+esc(i.subject)+'</b><br>'+esc(i.desc)+'<br><span class="smd-muted">since '+fmtT(i.since)+'</span></div>';});
      h+=card('Active problems',b,true);
    }
    if(d.system){
      var s=d.system,b='',lc=lvlCls(s.load_pct,t.cpu,1e9),mc=lvlCls(s.mem_pct,t.ram,1e9);
      b+='<div class="smd-row"><span>CPU load (5 min)</span><span class="'+lc+'">'+n1(s.load_pct)+' %</span></div>'+bar(s.load_pct,lc);
      b+='<div class="smd-row smd-muted"><span>Load 1 / 5 / 15</span><span>'+s.load.map(function(x){return x==null?'–':x.toFixed(2);}).join(' / ')+' ('+s.cores+' CPUs)</span></div>';
      b+='<div class="smd-row"><span>RAM</span><span class="'+mc+'">'+n1(s.mem_pct)+' %</span></div>'+bar(s.mem_pct,mc);
      b+='<div class="smd-row smd-muted"><span>Available / total</span><span>'+fmtB(s.mem_avail)+' / '+fmtB(s.mem_total)+'</span></div>';
      b+='<div class="smd-row"><span>Uptime</span><span>'+fmtUp(s.uptime)+'</span></div>';
      h+=card('System',b);
    }
    if('ups' in d){
      var b='';
      if(!d.ups)b='<span class="smd-muted">No UPS data (apcupsd not running).</span>';
      else{var u=d.ups,uc=/ONBATT|COMMLOST|REPLACEBATT|LOWBATT/i.test(u.status)?'smd-crit':'smd-ok';
        b+='<div class="smd-row"><span>Status</span><span>'+chip(u.status||'?',uc)+'</span></div>';
        b+='<div class="smd-row"><span>Charge</span><span>'+esc(u.charge||'–')+'</span></div>';
        b+='<div class="smd-row"><span>Time left</span><span>'+esc(u.timeleft||'–')+'</span></div>';
        b+='<div class="smd-row"><span>Load</span><span>'+esc(u.load||'–')+'</span></div>';
        if(u.model)b+='<div class="smd-row smd-muted"><span>Model</span><span>'+esc(u.model)+'</span></div>';}
      h+=card('UPS',b);
    }
    if(d.space){
      var b='';
      if(!d.space.length)b='<span class="smd-muted">None of the configured paths is mounted.</span>';
      d.space.forEach(function(p){var c=lvlCls(p.pct,t.space[0],t.space[1]);
        b+='<div class="smd-row"><span>'+esc(p.path)+'</span><span class="'+c+'">'+n1(p.pct)+' %</span></div>'+bar(p.pct,c);
        b+='<div class="smd-row smd-muted" style="margin-top:-.5em"><span></span><span>'+fmtB(p.free)+' free of '+fmtB(p.total)+'</span></div>';});
      h+=card('Storage space',b);
    }
    if('disks' in d){
      var b;
      if(!d.disks)b='<span class="smd-muted">disks.ini not readable.</span>';
      else{
        b='<div class="smd-scroll"><table><thead><tr><th>Disk</th><th>Device</th><th>Status</th><th>Temp.</th><th>Errors</th><th>SMART (last known)</th></tr></thead><tbody>';
        d.disks.forEach(function(k){
          var th=k.nvme?t.nvme:t.hdd, tc=k.type==='Flash'?'':lvlCls(k.temp,th[0],th[1]);
          var temp=k.temp==null?'<span class="smd-muted">'+(k.type==='Flash'?'–':'standby')+'</span>':'<span class="'+tc+'">'+k.temp+' °C</span>';
          var sm='<span class="smd-muted">–</span>';
          if(k.smart){var parts=[],bad=false;
            Object.keys(k.smart.counters||{}).forEach(function(l){var v=k.smart.counters[l];if(v>0){parts.push(l.replace(/_/g,' ')+': '+v);bad=true;}});
            if(k.smart.passed===false){parts.unshift('FAILED');bad=true;}
            if(k.smart.wear!=null)parts.push('wear '+k.smart.wear+' %');
            sm=bad?'<span class="smd-crit">'+esc(parts.join(', '))+'</span>':'<span class="smd-ok">OK</span>'+(parts.length?' <span class="smd-muted">'+esc(parts.join(', '))+'</span>':'');}
          b+='<tr><td>'+esc(k.name)+'</td><td>'+esc(k.device)+'</td><td>'+(k.status==='DISK_OK'?chip('OK','smd-ok'):chip(k.status,'smd-crit'))+'</td><td>'+temp+'</td><td class="'+(k.errors>0?'smd-crit':'')+'">'+k.errors+'</td><td>'+sm+'</td></tr>';});
        b+='</tbody></table></div>';
      }
      h+=card('Disks',b,true);
    }
    if('docker' in d){
      var b;
      if(!d.docker)b='<span class="smd-muted">Docker service not reachable.</span>';
      else{var all=d.docker_watch.indexOf('*')>=0,run=d.docker.filter(function(c){return c.state==='running';}).length,upd=d.docker.filter(function(c){return c.update_available;}).length;
        b='<div class="smd-row smd-muted"><span>'+run+' of '+d.docker.length+' running'+(upd?' · <span class="smd-warn">'+upd+' update(s)</span>':'')+'</span><span>'+(all?'All watched':'Watched: '+esc(d.docker_watch.join(', ')||'none'))+'</span></div>';
        b+='<div class="smd-scroll"><table><tbody>';
        d.docker.forEach(function(c){var w=all||d.docker_watch.indexOf(c.name)>=0,ok=c.state==='running';
          var cls=c.unhealthy?'smd-warn':(ok?'smd-ok':(w?'smd-crit':''));
          var info=(c.version?'v '+esc(c.version):'')+(c.updated?(c.version?' · ':'')+'updated '+fmtT(c.updated):'');
          b+='<tr><td>'+esc(c.name)+(w&&!all?' <span class="smd-muted">(watched)</span>':'')+'</td><td>'+chip(c.unhealthy?'unhealthy':c.state,cls)+(c.update_available?' '+chip('Update','smd-warn'):'')+'</td><td class="smd-muted">'+esc(c.status)+(info?'<br>'+info:'')+'</td></tr>';});
        b+='</tbody></table></div>';}
      h+=card('Docker',b);
    }
    if('vms' in d){
      var b;
      if(!d.vms)b='<span class="smd-muted">VM service not reachable.</span>';
      else if(!d.vms.length)b='<span class="smd-muted">No VMs defined.</span>';
      else{var all=d.vm_watch.indexOf('*')>=0;b='<table><tbody>';
        d.vms.forEach(function(v){var w=all||d.vm_watch.indexOf(v.name)>=0,ok=v.state==='running';
          var cls=v.state==='crashed'?'smd-crit':(ok?'smd-ok':(w?'smd-crit':''));
          b+='<tr><td>'+esc(v.name)+(w&&!all?' <span class="smd-muted">(watched)</span>':'')+'</td><td>'+chip(v.state||'?',cls)+'</td></tr>';});
        b+='</tbody></table>';}
      h+=card('VMs',b);
    }
    if('updates' in d){
      var b;
      if(!d.updates)b='<span class="smd-muted">No update information from Unraid available.</span>';
      else if(!d.updates.length)b='<span class="smd-ok">All images up to date.</span>';
      else{b='<div class="smd-row"><span class="smd-warn">'+d.updates.length+' update(s) available</span></div><ul style="margin:.3em 0 0 1.2em;padding:0">';
        d.updates.forEach(function(u){b+='<li>'+esc(u)+'</li>';});b+='</ul>';}
      h+=card('Docker updates',b);
    }
    if(d.sysupd){
      var su=d.sysupd,b='';
      if('os' in su){
        var o=su.os,os;
        if(!o)os='<span class="smd-muted">no check since boot</span>';
        else if(o.error)os='<span class="smd-warn">check failed</span>';
        else if(o.version)os=o.ignored?'<span class="smd-muted">'+esc(o.version)+' (ignored)</span>':chip(o.version+' available','smd-warn')+(o.eligible===false?' <span class="smd-muted">not eligible</span>':'');
        else os='<span class="smd-ok">up to date</span>';
        b+='<div class="smd-row"><span>Unraid OS '+esc(su.os_current||'?')+'</span><span>'+os+'</span></div>';
        if(o&&o.version&&o.eligible===false)b+='<div class="smd-row smd-muted"><span>License update period</span><span class="smd-warn">ended'+(o.update_exp?' '+esc(o.update_exp):'')+'</span></div>';
        if(o&&o.checked)b+='<div class="smd-row smd-muted"><span>Checked</span><span>'+fmtT(o.checked)+'</span></div>';
      }
      if('plugins' in su){
        var p=su.plugins;
        if(!p)b+='<div class="smd-row"><span>Plugins</span><span class="smd-muted">no check since boot</span></div>';
        else{var names=Object.keys(p.updates);
          b+='<div class="smd-row"><span>Plugins</span><span>'+(names.length?chip(names.length+' update(s)','smd-warn'):'<span class="smd-ok">up to date</span>')+'</span></div>';
          if(names.length){b+='<div class="smd-scroll"><table><tbody>';
            names.forEach(function(n){var v=p.updates[n];b+='<tr><td>'+esc(n)+'</td><td class="smd-muted">'+esc(v.installed)+' → <span class="smd-warn">'+esc(v.available)+'</span></td></tr>';});
            b+='</tbody></table></div>';}
          if(p.checked)b+='<div class="smd-row smd-muted"><span>Checked</span><span>'+fmtT(p.checked)+'</span></div>';}
      }
      if(su.recent&&su.recent.length){
        b+='<div class="smd-row" style="margin-top:.6em"><span>Updated in the last 7 days</span></div><div class="smd-scroll"><table><tbody>';
        su.recent.forEach(function(r){b+='<tr><td>'+esc(r.name)+'</td><td class="smd-muted">'+esc(r.version)+'</td><td class="smd-muted">'+fmtT(r.updated)+'</td></tr>';});
        b+='</tbody></table></div>';
      }
      if(!b)b='<span class="smd-muted">No plugin updates in the last 7 days.</span>';
      h+=card('Unraid OS and plugins',b);
    }
    if('certs' in d){
      var b;
      if(!d.certs)b='<span class="smd-muted">No certificate check has run yet.</span>';
      else if(!d.certs.items.length)b='<span class="smd-muted">No certificates found. Check directories and hosts in the settings.</span>';
      else{var ct=t.cert||[20,7];b='<div class="smd-scroll"><table><thead><tr><th>Name</th><th>Source</th><th>Valid until</th><th>Left</th><th>Note</th></tr></thead><tbody>';
        d.certs.items.forEach(function(c){
          var cls=(c.days==null||c.superseded)?'smd-muted':(c.days<=ct[1]?'smd-crit':(c.days<=ct[0]?'smd-warn':'smd-ok'));
          var note=c.error?'<span class="smd-crit">'+esc(c.error)+'</span>':[c.verify?'<span class="smd-warn">'+esc(c.verify)+'</span>':'',c.stale?'<span class="smd-warn">older than file</span>':'',c.superseded?'<span class="smd-muted">superseded by '+esc(c.superseded)+', ignored</span>':'',c.issuer?'<span class="smd-muted">'+esc(c.issuer)+'</span>':''].filter(Boolean).join(' · ');
          b+='<tr><td>'+esc(c.name)+(c.names&&c.names.length>1?' <span class="smd-muted">+'+(c.names.length-1)+'</span>':'')+'</td><td>'+esc(c.source)+'</td><td>'+(c.expires?new Date(c.expires*1000).toLocaleDateString('en-GB'):'–')+'</td><td class="'+cls+'">'+(c.days==null?'–':c.days+' d')+'</td><td>'+note+'</td></tr>';});
        b+='</tbody></table></div><div class="smd-muted" style="margin-top:.4em">Checked: '+fmtT(d.certs.time)+'</div>';}
      h+=card('TLS certificates',b,true);
    }
    if('ext' in d){
      var b;
      if(!d.ext)b='<span class="smd-muted">No external check has run yet.</span>';
      else if(!d.ext.items.length)b='<span class="smd-muted">No monitors in the UptimeRobot account.</span>';
      else{b='<div class="smd-scroll"><table><tbody>';
        d.ext.items.forEach(function(x){
          var cls=x.status==='DOWN'?'smd-crit':(x.status==='UP'?'smd-ok':(x.status==='LOOKS_DOWN'?'smd-warn':'smd-muted'));
          var note=x.status==='DOWN'?'since '+fmtT(x.since)+(x.reason?' · '+esc(x.reason):'')+(x.local?'<br>local: '+esc(x.local):''):esc(x.url);
          b+='<tr><td>'+esc(x.name)+(x.managed?'':' <span class="smd-muted">(not managed by srvmon)</span>')+'</td><td>'+chip(x.status||'?',cls)+'</td><td class="smd-muted">'+note+'</td></tr>';});
        b+='</tbody></table></div><div class="smd-muted" style="margin-top:.4em">Checked by UptimeRobot every 5 min · read: '+fmtT(d.ext.time)+'</div>';}
      h+=card('Reachability from the internet',b,true);
    }
    document.getElementById('smd-grid').innerHTML=h;
  }
  function load(){
    fetch(URL,{cache:'no-store',credentials:'same-origin'})
      .then(function(r){if(!r.ok)throw new Error('HTTP '+r.status);return r.json();})
      .then(render)
      .catch(function(e){document.getElementById('smd-summary').innerHTML='<span class="smd-crit">Could not load data ('+esc(e.message)+').</span>';});
  }
  load();
  setInterval(function(){if(!document.hidden)load();},REFRESH);
})();
</script>
]]></INLINE>
</FILE>

<FILE Run="/bin/bash">
<INLINE>
mkdir -p &plgpath;
chmod 0755 &emhttp;/scripts/check.php
# Cron: run every minute, the script checks the interval itself
cat > &plgpath;/&name;.cron &lt;&lt;'EOF'
# srvmon
* * * * * /usr/bin/php &emhttp;/scripts/check.php &gt;/dev/null 2&gt;&amp;1
EOF
/usr/local/sbin/update_cron
# update_cron only includes plugins that are already registered. srvmon is not registered yet
# while this script runs, so reload the cron entries after the installation has finished.
nohup bash -c 'sleep 15; /usr/local/sbin/update_cron' &gt;/dev/null 2&gt;&amp;1 &amp;
echo "srvmon &version; installed. Pages: Settings > User Utilities > Server Monitor / Server Monitor Status"
</INLINE>
</FILE>

<FILE Run="/bin/bash" Method="remove">
<INLINE>
rm -f &plgpath;/&name;.cron
/usr/local/sbin/update_cron
rm -rf &emhttp; /tmp/&name;
echo "srvmon removed. Configuration and state are kept in &plgpath;."
</INLINE>
</FILE>

</PLUGIN>
