<?xml version="1.0" standalone="yes"?>
<!DOCTYPE PLUGIN [
<!ENTITY name      "srvmon">
<!ENTITY author    "MarioKonang">
<!ENTITY version   "2026.10.18l">
<!ENTITY repo      "https://github.com/MarioKonang/unraid-srvmon">
<!ENTITY pluginURL "https://raw.githubusercontent.com/MarioKonang/unraid-srvmon/main/srvmon.plg">
<!ENTITY emhttp    "/usr/local/emhttp/plugins/&name;">
<!ENTITY plgpath   "/boot/config/plugins/&name;">
]>
<PLUGIN name="&name;" author="&author;" version="&version;" pluginURL="&pluginURL;" min="6.12.0" icon="heartbeat" launch="Settings/srvmon" support="&repo;">

<CHANGES>
###2026.10.18l
- Notification about available Unraid OS and plugin updates (from Unraid's own update checks, once per new version)
- Status page: new card "Unraid OS and plugins"
- New options CHECK_OS_UPDATES and CHECK_PLUGIN_UPDATES

###2026.10.18k
- All texts (user interface, notifications, documentation) translated to English
- Dates shown in ISO format (YYYY-MM-DD)

###2026.10.18j
- Published on GitHub, updates via the Plugins tab

###2026.10.18i
- Webhook delivery (e.g. to Home Assistant for Alexa announcements), minimum level configurable, max. 3 calls per run
- Heartbeat URL for external outage monitoring (healthchecks.io, Uptime Kuma)

###2026.10.18h
- Settings page grouped into sections

###2026.10.18g
- Certificate files superseded by a newer certificate for the same domains are ignored
- Hint about the host@LAN-IP:port notation when the live check cannot connect

###2026.10.18f
- Empty disk slots without device and ID are ignored (false alarm for an empty parity2 slot with DISK_NP_DSBL)

###2026.10.18e
- Cron entry is reloaded after the installation has finished (it was missing after installation before)
- Icon, description and link to the settings page in the plugin list

###2026.10.18d
- TLS certificates: expiry of certificate files (Nginx Proxy Manager) and of live served certificates
- Detection of nginx still serving the old certificate after a renewal
- Trust chain and hostname verification, certificate overview on the status page

###2026.10.18c
- Notification when a container was started with a new image (incl. version from image labels)
- Notification about available updates names the affected containers
- Status page: update hint, version and time of last update per container
- New option CHECK_DOCKER_UPDATED

###2026.10.18b
- New page "Server Monitor Status" with live view (refresh every 30 s)
- Data collection moved to include/lib.php, JSON endpoint include/data.php

###2026.10.18a
- CSRF token set explicitly in the settings form

###2026.10.18
- First version: disks, SMART, storage, Docker, VMs, system, UPS, Docker updates
</CHANGES>

<FILE Name="&emhttp;/README.md">
<INLINE><![CDATA[**Server Monitor (srvmon)**

Monitors disks, SMART, storage space, Docker containers and updates, Unraid OS and plugin updates, VMs, system, UPS and TLS certificates and reports problems via Unraid's notifications. Settings and live status under Settings > User Utilities.
]]></INLINE>
</FILE>

<FILE Name="&emhttp;/default.cfg">
<INLINE><![CDATA[INTERVAL="5"
CHECK_DISKS="yes"
CHECK_SMART="yes"
CHECK_SPACE="yes"
CHECK_DOCKER="yes"
CHECK_VMS="yes"
CHECK_SYSTEM="yes"
CHECK_UPS="yes"
CHECK_UPDATES="yes"
CHECK_DOCKER_UPDATED="yes"
CHECK_OS_UPDATES="yes"
CHECK_PLUGIN_UPDATES="yes"
TEMP_HDD_WARN="45"
TEMP_HDD_CRIT="50"
TEMP_NVME_WARN="60"
TEMP_NVME_CRIT="70"
SPACE_PATHS="/mnt/user,/mnt/cache,/var/log,/var/lib/docker"
SPACE_WARN="85"
SPACE_CRIT="95"
DOCKER_WATCH="*"
VM_WATCH=""
CPU_LOAD_WARN="90"
RAM_WARN="90"
REMIND_HOURS="24"
NOTIFY_RESOLVED="yes"
CHECK_CERTS="yes"
CERT_DIRS="/mnt/user/appdata/NginxProxyManager/letsencrypt/live"
CERT_HOSTS=""
CERT_WARN_DAYS="20"
CERT_CRIT_DAYS="7"
CERT_VERIFY="yes"
CERT_IGNORE=""
WEBHOOK_URL=""
WEBHOOK_LEVEL="warning"
HEARTBEAT_URL=""
]]></INLINE>
</FILE>

<FILE Name="&emhttp;/include/lib.php">
<INLINE><![CDATA[<?php
/*
 * srvmon - shared functions for check.php (checks) and data.php (status page)
 */
declare(strict_types=1);

const SM_DEF_CFG     = '/usr/local/emhttp/plugins/srvmon/default.cfg';
const SM_USR_CFG     = '/boot/config/plugins/srvmon/srvmon.cfg';
const SM_STATE       = '/boot/config/plugins/srvmon/state.json';   // flash: written only on change
const SM_TMP         = '/tmp/srvmon';                              // RAM
const SM_NOTIFY      = '/usr/local/emhttp/webGui/scripts/notify';
const SM_DISKS_INI   = '/var/local/emhttp/disks.ini';
const SM_DOCKER_UPD  = '/var/lib/docker/unraid-update-status.json';
const SM_OS_VERSION  = '/etc/unraid-version';
const SM_OS_CHECK    = '/tmp/unraidcheck/result.json';    // result of Unraid's OS update check
const SM_OS_IGNORED  = '/tmp/unraidcheck/ignored.json';   // releases ignored in the Update OS dialog
const SM_PLG_NEW     = '/tmp/plugins';                    // .plg files downloaded by Unraid's plugin check
const SM_PLG_LOCAL   = '/var/log/plugins';                // installed plugins

// Watched ATA counters: id => [label, level on increase]
const SM_ATA_WATCH = [
    5   => ['Reallocated_Sector_Ct',  'alert'],
    187 => ['Reported_Uncorrect',     'alert'],
    197 => ['Current_Pending_Sector', 'alert'],
    198 => ['Offline_Uncorrectable',  'alert'],
    199 => ['UDMA_CRC_Error_Count',   'warning'],   // usually cable/backplane
];

// ------------------------------------------------------------ Configuration

function sm_load_cfg(): array
{
    $def = @parse_ini_file(SM_DEF_CFG) ?: [];
    $usr = is_file(SM_USR_CFG) ? (@parse_ini_file(SM_USR_CFG) ?: []) : [];
    return array_merge($def, $usr);
}

function sm_load_state(): array
{
    $j = json_decode((string)@file_get_contents(SM_STATE), true);
    return is_array($j) ? $j : [];
}

function sm_save_state(array $state): void
{
    $json = json_encode($state, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE);
    if ($json === false || @file_get_contents(SM_STATE) === $json) return;   // spare the flash drive
    @mkdir(dirname(SM_STATE), 0755, true);
    if (@file_put_contents(SM_STATE . '.tmp', $json) !== false) @rename(SM_STATE . '.tmp', SM_STATE);
}

// parse_ini_file turns yes/no into "1"/"", so evaluate leniently
function sm_on(array $c, string $k): bool
{
    return in_array(strtolower(trim((string)($c[$k] ?? ''))), ['1', 'yes', 'true', 'on'], true);
}

function sm_num(array $c, string $k, float $def): float
{
    $v = $c[$k] ?? '';
    return is_numeric($v) ? (float)$v : $def;
}

function sm_list($v): array
{
    return array_values(array_filter(array_map('trim', explode(',', (string)$v)), 'strlen'));
}

function sm_bytes(float $b): string
{
    $u = ['B', 'KB', 'MB', 'GB', 'TB', 'PB'];
    $i = 0;
    while ($b >= 1024 && $i < count($u) - 1) { $b /= 1024; $i++; }
    return sprintf('%.1f %s', $b, $u[$i]);
}

// ------------------------------------------------------------ Data collectors
// Each collector returns null if its source is unavailable.

function sm_get_disks(): ?array
{
    $ini = @parse_ini_file(SM_DISKS_INI, true);
    if (!is_array($ini)) return null;
    $r = [];
    foreach ($ini as $sec => $d) {
        if (!is_array($d)) continue;
        $status = (string)($d['status'] ?? '');
        $dev    = (string)($d['device'] ?? '');
        if ($status === '' || $status === 'DISK_NP') continue;   // empty slot
        // Unassigned slot without device and ID (e.g. empty parity2 slot reported as DISK_NP_DSBL).
        // An assigned but missing disk keeps its ID and is still reported.
        if ($dev === '' && trim((string)($d['id'] ?? '')) === '') continue;
        $temp = $d['temp'] ?? '';
        $r[] = [
            'name'   => (string)($d['name'] ?? $sec),
            'device' => $dev,
            'id'     => (string)($d['id'] ?? $dev),
            'status' => $status,
            'type'   => (string)($d['type'] ?? ''),
            'temp'   => is_numeric($temp) ? (float)$temp : null,   // null = spun down / unknown
            'errors' => (int)($d['numErrors'] ?? 0),
            'nvme'   => strncmp($dev, 'nvme', 4) === 0,
        ];
    }
    return $r;
}

/** Read SMART without waking sleeping disks. null = standby or unreadable. */
function sm_get_smart(string $dev): ?array
{
    $out = []; $rc = 0;
    exec('timeout 60 smartctl -n standby -j -H -A ' . escapeshellarg("/dev/$dev") . ' 2>/dev/null', $out, $rc);
    $j = json_decode(implode("\n", $out), true);
    if (!is_array($j) || !isset($j['smart_status']['passed'])) return null;

    $res = ['passed' => $j['smart_status']['passed'] === true, 'counters' => [], 'nvme_cw' => null, 'wear' => null];
    foreach ($j['ata_smart_attributes']['table'] ?? [] as $a) {
        $aid = (int)($a['id'] ?? 0);
        if (isset(SM_ATA_WATCH[$aid])) {
            $res['counters'][SM_ATA_WATCH[$aid][0]] = [(int)($a['raw']['value'] ?? 0), SM_ATA_WATCH[$aid][1]];
        }
    }
    $nv = $j['nvme_smart_health_information_log'] ?? null;
    if (is_array($nv)) {
        $res['counters']['Media_Errors'] = [(int)($nv['media_errors'] ?? 0), 'alert'];
        $res['nvme_cw'] = (int)($nv['critical_warning'] ?? 0);
        $res['wear']    = (int)($nv['percentage_used'] ?? 0);
    }
    return $res;
}

function sm_mounted(string $p): bool
{
    $o = []; $rc = 0;
    exec('mountpoint -q ' . escapeshellarg($p) . ' 2>/dev/null', $o, $rc);
    return $rc === 0;
}

function sm_get_space(array $paths): array
{
    $r = [];
    foreach ($paths as $p) {
        if (!sm_mounted($p)) continue;          // not mounted (e.g. array stopped)
        $t = @disk_total_space($p);
        $f = @disk_free_space($p);
        if (!$t || $f === false) continue;
        $r[] = ['path' => $p, 'total' => $t, 'free' => $f, 'pct' => round(100.0 * (1 - $f / $t), 1)];
    }
    return $r;
}

function sm_get_docker(): ?array
{
    $out = []; $rc = 0;
    exec("timeout 30 docker ps -a --format '{{.Names}}\t{{.State}}\t{{.Status}}' 2>/dev/null", $out, $rc);
    if ($rc !== 0) return null;                 // Docker service off or unreachable
    $r = [];
    foreach ($out as $line) {
        $f = explode("\t", $line);
        if (count($f) < 3) continue;
        $r[] = ['name' => $f[0], 'state' => $f[1], 'status' => $f[2],
                'unhealthy' => stripos($f[2], '(unhealthy)') !== false];
    }
    usort($r, fn($a, $b) => strcasecmp($a['name'], $b['name']));
    return $r;
}

function sm_get_vms(): ?array
{
    $out = []; $rc = 0;
    exec('timeout 30 virsh list --all --name 2>/dev/null', $out, $rc);
    if ($rc !== 0) return null;                 // VM service off
    $r = [];
    foreach (array_filter(array_map('trim', $out), 'strlen') as $vm) {
        $st  = trim((string)shell_exec('timeout 10 virsh domstate ' . escapeshellarg($vm) . ' 2>/dev/null'));
        $r[] = ['name' => $vm, 'state' => $st];
    }
    usort($r, fn($a, $b) => strcasecmp($a['name'], $b['name']));
    return $r;
}

function sm_get_system(): array
{
    $la    = explode(' ', (string)@file_get_contents('/proc/loadavg'));
    $cores = max(1, (int)trim((string)shell_exec('nproc 2>/dev/null')));
    $mi    = [];
    foreach (@file('/proc/meminfo') ?: [] as $l) {
        if (preg_match('/^(\w+):\s+(\d+)/', $l, $m)) $mi[$m[1]] = (int)$m[2] * 1024;
    }
    $total = $mi['MemTotal'] ?? 0;
    $avail = $mi['MemAvailable'] ?? null;
    $load5 = isset($la[1]) && is_numeric($la[1]) ? (float)$la[1] : null;
    return [
        'load'      => [isset($la[0]) && is_numeric($la[0]) ? (float)$la[0] : null, $load5,
                        isset($la[2]) && is_numeric($la[2]) ? (float)$la[2] : null],
        'cores'     => $cores,
        'load_pct'  => $load5 === null ? null : round($load5 / $cores * 100, 1),
        'mem_total' => $total,
        'mem_avail' => $avail,
        'mem_pct'   => ($total > 0 && $avail !== null) ? round(100.0 * (1 - $avail / $total), 1) : null,
        'uptime'    => (int)(float)explode(' ', (string)@file_get_contents('/proc/uptime'))[0],
        'boot_id'   => trim((string)@file_get_contents('/proc/sys/kernel/random/boot_id')),
    ];
}

function sm_get_ups(): ?array
{
    $out = []; $rc = 0;
    exec('timeout 10 apcaccess status 2>/dev/null', $out, $rc);
    if ($rc !== 0 || !$out) return null;        // apcupsd not running
    $u = [];
    foreach ($out as $l) {
        $p = strpos($l, ':');
        if ($p !== false) $u[trim(substr($l, 0, $p))] = trim(substr($l, $p + 1));
    }
    return ['status' => $u['STATUS'] ?? '', 'charge' => $u['BCHARGE'] ?? '',
            'timeleft' => $u['TIMELEFT'] ?? '', 'load' => $u['LOADPCT'] ?? '', 'model' => $u['MODEL'] ?? ''];
}

/**
 * Image information per container: image ID, image reference and version from labels.
 * Used to detect performed updates (new image ID for the same container).
 */
function sm_get_docker_images(): ?array
{
    $ids = []; $rc = 0;
    exec('timeout 30 docker ps -aq 2>/dev/null', $ids, $rc);
    if ($rc !== 0) return null;
    $ids = array_filter(array_map('trim', $ids), 'strlen');
    if (!$ids) return [];
    $out = [];
    $fmt = '{{.Name}}\t{{.Image}}\t{{.Config.Image}}\t{{json .Config.Labels}}';
    exec('timeout 60 docker inspect --format ' . escapeshellarg($fmt) . ' '
         . implode(' ', array_map('escapeshellarg', $ids)) . ' 2>/dev/null', $out, $rc);
    if ($rc !== 0) return null;              // e.g. container removed meanwhile: retry next run
    $r = [];
    foreach ($out as $line) {
        $f = explode("\t", $line, 4);
        if (count($f) < 4) continue;
        $labels  = json_decode($f[3], true);
        $labels  = is_array($labels) ? $labels : [];
        $version = (string)($labels['org.opencontainers.image.version'] ?? $labels['version'] ?? $labels['build_version'] ?? '');
        $r[ltrim($f[0], '/')] = ['id' => $f[1], 'image' => $f[2], 'version' => preg_match('/^.{0,80}/us', trim($version), $m) ? $m[0] : ''];
    }
    return $r;
}

/** Normalise an image reference: a missing tag becomes :latest. */
function sm_norm_image(string $ref): string
{
    $ref  = trim($ref);
    if ($ref === '' || strpos($ref, '@') !== false) return $ref;
    $last = substr($ref, (int)strrpos('/' . $ref, '/'));
    return strpos($last, ':') === false ? "$ref:latest" : $ref;
}

/** Reads Unraid's own Docker update check; srvmon does not query registries itself. */
function sm_get_updates(): ?array
{
    $raw = @file_get_contents(SM_DOCKER_UPD);
    if ($raw === false) return null;
    $j = json_decode($raw, true);
    if (!is_array($j)) return null;
    $avail = [];
    foreach ($j as $image => $e) {
        if (!is_array($e)) continue;
        $l = (string)($e['local'] ?? '');
        $r = (string)($e['remote'] ?? '');
        if ($l !== '' && $r !== '' && $l !== 'undef' && $r !== 'undef' && $l !== $r) $avail[] = (string)$image;
    }
    sort($avail);
    return $avail;
}

function sm_os_version(): string
{
    $v = @parse_ini_file(SM_OS_VERSION) ?: [];
    return (string)($v['version'] ?? '');
}

/**
 * Reads the result of Unraid's own OS update check; srvmon does not query the release server itself.
 * null = no check has run since boot.
 */
function sm_get_os_update(): ?array
{
    if (!is_file(SM_OS_CHECK)) return null;
    $j = json_decode((string)@file_get_contents(SM_OS_CHECK), true);
    if (!is_array($j)) return null;
    $cur = sm_os_version();
    $ver = (string)($j['version'] ?? '');
    $ign = json_decode((string)@file_get_contents(SM_OS_IGNORED), true);
    $ign = is_array($ign['updateOsIgnoredReleases'] ?? null) ? $ign['updateOsIgnoredReleases'] : [];
    // isNewer refers to the version at check time; compare again in case an update was installed meanwhile
    $newer = !empty($j['isNewer']) && $ver !== '' && ($cur === '' || version_compare($ver, $cur, '>'));
    return [
        'current' => $cur,
        'version' => $newer ? $ver : null,
        'ignored' => $newer && in_array($ver, $ign, true),
        'error'   => isset($j['error']) ? (string)$j['error'] : null,
        'checked' => (int)@filemtime(SM_OS_CHECK),
    ];
}

/** Attribute of a .plg file (entities resolved), as Unraid's plugin manager reads it. */
function sm_plg_attr(string $file, string $attr): string
{
    $xml = @simplexml_load_file($file, null, LIBXML_NOCDATA);
    return $xml === false ? '' : (string)($xml->attributes()[$attr] ?? '');
}

/**
 * Compares the .plg files downloaded by Unraid's plugin check with the installed ones.
 * Same rules as Unraid: string comparison of the version, min/max OS version must fit.
 * null = no plugin check has run since boot.
 */
function sm_get_plugin_updates(): ?array
{
    $files = glob(SM_PLG_NEW . '/*.plg') ?: [];
    if (!$files) return null;
    $os  = sm_os_version();
    $r   = [];
    $chk = 0;
    foreach ($files as $f) {
        $name = basename($f, '.plg');
        if (in_array($name, ['unRAIDServer', 'unRAIDServer-'], true)) continue;   // OS, see sm_get_os_update
        $chk = max($chk, (int)@filemtime($f));
        $installed = SM_PLG_LOCAL . "/$name.plg";
        if (!is_file($installed)) continue;              // downloaded but not installed
        $new = sm_plg_attr($f, 'version');
        $old = sm_plg_attr($installed, 'version');
        if ($new === '' || $old === '' || strcmp($new, $old) <= 0) continue;
        $min = sm_plg_attr($f, 'min');
        $max = sm_plg_attr($f, 'max');
        if ($os !== '' && (($min !== '' && version_compare($min, $os, '>')) || ($max !== '' && version_compare($max, $os, '<')))) continue;
        $r[$name] = ['installed' => $old, 'available' => $new];
    }
    ksort($r, SORT_NATURAL | SORT_FLAG_CASE);
    return ['updates' => $r, 'checked' => $chk ?: null];
}

// ------------------------------------------------------------ TLS certificates

/** Parse the output of "openssl x509 -noout -enddate -subject -issuer -ext subjectAltName". */
function sm_parse_x509(array $out): ?array
{
    $end = null; $subj = ''; $iss = ''; $names = [];
    foreach ($out as $l) {
        $l = trim($l);
        if (strncmp($l, 'notAfter=', 9) === 0)    $end  = strtotime(substr($l, 9)) ?: null;
        elseif (strncmp($l, 'subject=', 8) === 0) $subj = substr($l, 8);
        elseif (strncmp($l, 'issuer=', 7) === 0)  $iss  = substr($l, 7);
        if (preg_match_all('/DNS:([^,\s]+)/', $l, $m)) $names = array_merge($names, $m[1]);
    }
    if ($end === null) return null;
    $cn  = preg_match('/CN\s*=\s*([^,\/]+)/', $subj, $m) ? trim($m[1]) : '';
    $isn = preg_match('/CN\s*=\s*([^,\/]+)/', $iss, $m) ? trim($m[1])
         : (preg_match('/O\s*=\s*([^,\/]+)/', $iss, $m) ? trim($m[1]) : '');
    $names = array_values(array_unique($names ?: ($cn !== '' ? [$cn] : [])));
    return ['expires' => $end, 'names' => $names, 'issuer' => $isn];
}

function sm_cert_from_file(string $file): ?array
{
    $out = []; $rc = 0;
    exec('timeout 15 openssl x509 -noout -enddate -subject -issuer -ext subjectAltName -in '
         . escapeshellarg($file) . ' 2>/dev/null', $out, $rc);
    return $rc === 0 ? sm_parse_x509($out) : null;
}

/** Looks in every directory for <dir>/*\/fullchain.pem (Let's Encrypt "live" layout). */
function sm_get_cert_files(array $dirs): array
{
    $res = ['missing' => [], 'certs' => []];
    foreach ($dirs as $dir) {
        $dir = rtrim($dir, '/');
        if (!is_dir($dir)) { $res['missing'][] = $dir; continue; }
        $files = glob("$dir/*/fullchain.pem") ?: [];
        if (is_file("$dir/fullchain.pem")) $files[] = "$dir/fullchain.pem";
        foreach ($files as $f) {
            $id = basename(dirname($f));
            $c  = sm_cert_from_file($f);
            $res['certs'][] = $c === null
                ? ['id' => $id, 'path' => $f, 'error' => 'Certificate not readable']
                : $c + ['id' => $id, 'path' => $f];
        }
    }
    return $res;
}

/**
 * Parse an entry. Allowed: "host", "host:port", "host@address", "host@address:port"
 * and "host:port@address". Without an address the hostname is used, without a port 443.
 */
function sm_parse_cert_host(string $e): array
{
    [$hp, $addr] = array_pad(explode('@', trim($e), 2), 2, '');
    $host = $hp; $port = 443;
    if (preg_match('/^(.+):(\d+)$/', $hp, $m)) { $host = $m[1]; $port = (int)$m[2]; }
    if (preg_match('/^(.+):(\d+)$/', $addr, $m)) { $addr = $m[1]; $port = (int)$m[2]; }
    return ['host' => $host, 'port' => $port, 'addr' => $addr !== '' ? $addr : $host];
}

/** Fetch and check the served certificate via TLS handshake (with SNI). */
function sm_get_cert_live(string $entry): array
{
    $t   = sm_parse_cert_host($entry);
    $res = $t + ['error' => null, 'verify' => null];
    $out = []; $rc = 0;
    exec('timeout 15 openssl s_client -connect ' . escapeshellarg($t['addr'] . ':' . $t['port'])
         . ' -servername ' . escapeshellarg($t['host'])
         . ' -verify_hostname ' . escapeshellarg($t['host'])
         . ' </dev/null 2>/dev/null', $out, $rc);
    $txt = implode("\n", $out);
    if (!preg_match('/-----BEGIN CERTIFICATE-----.+?-----END CERTIFICATE-----/s', $txt, $m)) {
        $res['error'] = 'No TLS connection to ' . $t['addr'] . ':' . $t['port'];
        return $res;
    }
    if (preg_match('/Verify return code: (\d+) \(([^)]*)\)/', $txt, $v)) {
        $res['verify'] = ['code' => (int)$v[1], 'text' => $v[2]];
    }
    @mkdir(SM_TMP, 0755, true);
    $tmp = tempnam(SM_TMP, 'cert');
    file_put_contents($tmp, $m[0]);
    $c = sm_cert_from_file($tmp);
    @unlink($tmp);
    if ($c === null) { $res['error'] = 'Certificate could not be parsed'; return $res; }
    return $res + $c;
}

/** Does the certificate cover the hostname? Wildcards match exactly one label. */
function sm_cert_covers(array $names, string $host): bool
{
    $host = strtolower($host);
    foreach ($names as $n) {
        $n = strtolower($n);
        if ($n === $host) return true;
        if (strncmp($n, '*.', 2) === 0) {
            $dot = strpos($host, '.');
            if ($dot !== false && substr($host, $dot + 1) === substr($n, 2)) return true;
        }
    }
    return false;
}
]]></INLINE>
</FILE>

<FILE Name="&emhttp;/include/data.php">
<INLINE><![CDATA[<?php
/*
 * srvmon - JSON endpoint for the status page.
 * Located under /plugins/srvmon/include/ and therefore protected by the WebGUI login.
 * SMART is NOT read live here (too slow); the last state from check.php is shown instead.
 */
declare(strict_types=1);
require_once '/usr/local/emhttp/plugins/srvmon/include/lib.php';

header('Content-Type: application/json; charset=utf-8');
header('Cache-Control: no-store');

$cfg    = sm_load_cfg();
$state  = sm_load_state();
$status = json_decode((string)@file_get_contents(SM_TMP . '/status.json'), true) ?: [];

$issues = [];
foreach ($state['issues'] ?? [] as $k => $i) {
    $issues[] = ['key' => (string)$k, 'level' => $i['level'] ?? 'warning', 'subject' => $i['subject'] ?? '',
                 'desc' => $i['desc'] ?? '', 'since' => (int)($i['since'] ?? 0)];
}
usort($issues, fn($a, $b) => (['alert' => 0, 'warning' => 1][$a['level']] ?? 2)
                            <=> (['alert' => 0, 'warning' => 1][$b['level']] ?? 2));

$out = [
    'time'    => time(),
    'lastrun' => isset($status['lastrun']) ? (int)$status['lastrun'] : null,
    'issues'  => $issues,
    'thresholds' => [
        'hdd'   => [sm_num($cfg, 'TEMP_HDD_WARN', 45),  sm_num($cfg, 'TEMP_HDD_CRIT', 50)],
        'nvme'  => [sm_num($cfg, 'TEMP_NVME_WARN', 60), sm_num($cfg, 'TEMP_NVME_CRIT', 70)],
        'space' => [sm_num($cfg, 'SPACE_WARN', 85),     sm_num($cfg, 'SPACE_CRIT', 95)],
        'cpu'   => sm_num($cfg, 'CPU_LOAD_WARN', 90),
        'ram'   => sm_num($cfg, 'RAM_WARN', 90),
    ],
];

if (sm_on($cfg, 'CHECK_SYSTEM')) $out['system'] = sm_get_system();
unset($out['system']['boot_id']);

if (sm_on($cfg, 'CHECK_DISKS')) {
    $disks = sm_get_disks();
    if ($disks !== null) {
        foreach ($disks as &$d) {
            $d['smart'] = $state['smart'][$d['id']] ?? null;
            unset($d['id']);   // usually contains the serial number, not needed in the browser
        }
        unset($d);
    }
    $out['disks'] = $disks;
}
if (sm_on($cfg, 'CHECK_SPACE'))   $out['space']  = sm_get_space(sm_list($cfg['SPACE_PATHS'] ?? ''));
if (sm_on($cfg, 'CHECK_DOCKER')) {
    $out['docker']       = sm_get_docker();
    $out['docker_watch'] = sm_list($cfg['DOCKER_WATCH'] ?? '');
    if (is_array($out['docker'])) {
        $avail = array_map('sm_norm_image', sm_get_updates() ?? []);
        foreach ($out['docker'] as &$c) {
            $img = $state['docker_img'][$c['name']] ?? null;   // state of the last check
            $c['version']          = $img['version'] ?? '';
            $c['updated']          = $img['updated'] ?? null;
            $c['update_available'] = $img !== null && in_array(sm_norm_image((string)$img['image']), $avail, true);
        }
        unset($c);
    }
}
if (sm_on($cfg, 'CHECK_VMS')) {
    $out['vms']      = sm_get_vms();
    $out['vm_watch'] = sm_list($cfg['VM_WATCH'] ?? '');
}
if (sm_on($cfg, 'CHECK_UPS'))     $out['ups']     = sm_get_ups();
if (sm_on($cfg, 'CHECK_UPDATES')) $out['updates'] = sm_get_updates();
if (sm_on($cfg, 'CHECK_OS_UPDATES') || sm_on($cfg, 'CHECK_PLUGIN_UPDATES')) {
    $out['sysupd'] = ['os_current' => sm_os_version()];
    if (sm_on($cfg, 'CHECK_OS_UPDATES'))     $out['sysupd']['os']      = sm_get_os_update();
    if (sm_on($cfg, 'CHECK_PLUGIN_UPDATES')) $out['sysupd']['plugins'] = sm_get_plugin_updates();
}
if (sm_on($cfg, 'CHECK_CERTS')) {
    // result of the last check run; no TLS handshakes on every page load
    $certs = json_decode((string)@file_get_contents(SM_TMP . '/certs.json'), true);
    $out['certs'] = is_array($certs) ? $certs : null;
    $out['thresholds']['cert'] = [sm_num($cfg, 'CERT_WARN_DAYS', 20), sm_num($cfg, 'CERT_CRIT_DAYS', 7)];
}

echo json_encode($out, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE);
]]></INLINE>
</FILE>

<FILE Name="&emhttp;/scripts/check.php" Mode="0755">
<INLINE><![CDATA[#!/usr/bin/php
<?php
/*
 * srvmon - health monitoring for Unraid
 *
 * Usage:  check.php [--force] [--dry-run] [--test]
 *   --force    ignore the interval and check immediately
 *   --dry-run  print only; send nothing, do not save state
 *   --test     send a test notification
 *
 * Notifications are sent exclusively via Unraid's notify script. Whether an
 * email goes out is controlled by the agents under Settings > Notifications.
 */
declare(strict_types=1);
require_once '/usr/local/emhttp/plugins/srvmon/include/lib.php';

const SM_MAX_PER_RUN = 10;
const SM_MAX_HOOKS   = 3;     // webhook calls per run, so a voice assistant does not talk for minutes

$opt   = getopt('', ['force', 'dry-run', 'test']);
$force = isset($opt['force']);
$dry   = isset($opt['dry-run']);
$cfg   = sm_load_cfg();

if (isset($opt['test'])) {
    sm_send('normal', 'Test notification',
        'srvmon is active. If you receive this message, delivery is set up correctly.', true);
    exit(0);
}

@mkdir(SM_TMP, 0755, true);
$lock = fopen(SM_TMP . '/lock', 'c');
if ($lock === false || !flock($lock, LOCK_EX | LOCK_NB)) exit(0);

$runFile  = SM_TMP . '/lastrun';
$interval = max(1, (int)sm_num($cfg, 'INTERVAL', 5)) * 60;
$last     = (int)@file_get_contents($runFile);
if (!$force && time() - $last < $interval - 10) exit(0);
if (!$dry) file_put_contents($runFile, (string)time());

$state  = sm_load_state();
$issues = [];   // ongoing conditions: key => [level, subject, desc]
$events = [];   // one-off events: [level, subject, desc]
$ran    = [];   // key prefixes of checks that delivered data

if (sm_on($cfg, 'CHECK_DISKS'))   sm_check_disks($cfg, $state, $issues, $events, $ran);
if (sm_on($cfg, 'CHECK_SPACE'))   sm_check_space($cfg, $issues, $ran);
if (sm_on($cfg, 'CHECK_DOCKER'))  sm_check_docker($cfg, $state, $issues, $events, $ran);
if (sm_on($cfg, 'CHECK_DOCKER') && sm_on($cfg, 'CHECK_DOCKER_UPDATED')) sm_check_docker_updated($state, $events);
if (sm_on($cfg, 'CHECK_VMS'))     sm_check_vms($cfg, $state, $issues, $events, $ran);
if (sm_on($cfg, 'CHECK_SYSTEM'))  sm_check_system($cfg, $state, $issues, $events, $ran);
if (sm_on($cfg, 'CHECK_UPS'))     sm_check_ups($issues, $ran);
if (sm_on($cfg, 'CHECK_UPDATES')) sm_check_updates($state, $events);
if (sm_on($cfg, 'CHECK_OS_UPDATES'))     sm_check_os_update($state, $events);
if (sm_on($cfg, 'CHECK_PLUGIN_UPDATES')) sm_check_plugin_updates($state, $events);
if (sm_on($cfg, 'CHECK_CERTS'))   sm_check_certs($cfg, $force, $state, $issues, $ran);

// ---------------------------------------------------------------- Evaluation
$now    = time();
$remind = (int)sm_num($cfg, 'REMIND_HOURS', 24) * 3600;
$prev   = $state['issues'] ?? [];
$next   = [];
$queue  = [];

foreach ($issues as $key => [$lvl, $subj, $desc]) {
    $p = $prev[$key] ?? null;
    if ($p === null || sm_rank($lvl) > sm_rank((string)$p['level'])) {
        $queue[] = [$lvl, $subj, $desc];
        $next[$key] = ['level' => $lvl, 'subject' => $subj, 'desc' => $desc,
                       'since' => $p['since'] ?? $now, 'notified' => $now];
    } elseif ($remind > 0 && $now - (int)$p['notified'] >= $remind) {
        $queue[] = [$lvl, "Still active: $subj",
                    $desc . ' (since ' . date('Y-m-d H:i', (int)$p['since']) . ')'];
        $next[$key] = ['level' => $lvl, 'subject' => $subj, 'desc' => $desc,
                       'since' => $p['since'], 'notified' => $now];
    } else {
        // do not update the description, otherwise the flash drive would be written on every run
        $p['level'] = $lvl;
        $next[$key] = $p;
    }
}
foreach ($prev as $key => $p) {
    if (isset($next[$key])) continue;
    if (!sm_prefix_ran((string)$key, $ran)) { $next[$key] = $p; continue; }   // check did not run: decide nothing
    if (sm_on($cfg, 'NOTIFY_RESOLVED')) {
        $queue[] = ['normal', 'Resolved: ' . $p['subject'], 'The condition is back to normal.'];
    }
}
$state['issues'] = $next;
$queue = array_merge($queue, $events);

$sent = 0;
foreach ($queue as [$lvl, $subj, $desc]) {
    if ($sent >= SM_MAX_PER_RUN) {
        sm_send('warning', 'Further notifications suppressed',
            (count($queue) - $sent) . ' more notifications in this run. Details in the syslog (tag srvmon).');
        break;
    }
    sm_send($lvl, $subj, $desc);
    $sent++;
}

sm_webhook_flush();

if (!$dry) {
    // heartbeat for external monitoring (e.g. healthchecks.io, Uptime Kuma push); in the background, non-blocking
    $hb = trim((string)($cfg['HEARTBEAT_URL'] ?? ''));
    if ($hb !== '') exec('curl -fsS -m 10 --retry 2 -o /dev/null ' . escapeshellarg($hb) . ' >/dev/null 2>&1 &');
    sm_save_state($state);
    @file_put_contents(SM_TMP . '/status.json', json_encode(
        ['lastrun' => $now, 'issues' => $next], JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE));
}
exit(0);

// ================================================================== Checks

function sm_check_disks(array $cfg, array &$state, array &$issues, array &$events, array &$ran): void
{
    $disks = sm_get_disks();
    if ($disks === null) return;
    $ran[] = 'disk:';
    $smartOn = sm_on($cfg, 'CHECK_SMART');
    if ($smartOn) $ran[] = 'smart:';

    foreach ($disks as $d) {
        ['name' => $name, 'device' => $dev, 'status' => $status] = $d;

        if ($status !== 'DISK_OK') {
            $issues["disk:$name:status"] = ['alert', "Disk $name: Status $status",
                "Disk $name (" . ($dev !== '' ? $dev : 'no device detected') . ") reports status $status."];
        }
        if ($d['errors'] > 0) {
            $issues["disk:$name:errors"] = ['alert', "Disk $name: I/O errors",
                "Unraid counts {$d['errors']} read/write errors on disk $name ($dev)."];
        }
        if ($d['type'] === 'Flash') continue;

        if ($d['temp'] !== null) {
            $t = $d['temp'];
            $w = sm_num($cfg, $d['nvme'] ? 'TEMP_NVME_WARN' : 'TEMP_HDD_WARN', $d['nvme'] ? 60 : 45);
            $c = sm_num($cfg, $d['nvme'] ? 'TEMP_NVME_CRIT' : 'TEMP_HDD_CRIT', $d['nvme'] ? 70 : 50);
            if ($t >= $c) {
                $issues["disk:$name:temp"] = ['alert', "Disk $name: temperature critical",
                    "Disk $name ($dev) is at {$t} °C (critical from {$c} °C)."];
            } elseif ($t >= $w) {
                $issues["disk:$name:temp"] = ['warning', "Disk $name: temperature high",
                    "Disk $name ($dev) is at {$t} °C (warning from {$w} °C)."];
            }
        }
        if ($smartOn && $dev !== '') sm_check_smart($d, $state, $issues, $events);
    }
}

function sm_check_smart(array $d, array &$state, array &$issues, array &$events): void
{
    ['name' => $name, 'device' => $dev, 'id' => $id] = $d;
    $s = sm_get_smart($dev);
    if ($s === null) {                       // standby or unreadable: keep the previous state
        sm_keep($state, $issues, "smart:$name:");
        return;
    }
    if (!$s['passed']) {
        $issues["smart:$name:health"] = ['alert', "Disk $name: SMART status FAILED",
            "The overall SMART status of disk $name ($dev) is FAILED. Replace the disk soon."];
    }
    if ($s['nvme_cw']) {
        $issues["smart:$name:nvme_cw"] = ['alert', "Disk $name: NVMe Critical Warning",
            sprintf('Disk %s (%s) reports critical_warning = 0x%02x.', $name, $dev, $s['nvme_cw'])];
    }
    if ($s['wear'] !== null && $s['wear'] >= 90) {
        $issues["smart:$name:wear"] = ['warning', "Disk $name: wear {$s['wear']} %",
            "According to SMART, disk $name ($dev) has used {$s['wear']} % of its rated lifetime."];
    }

    $base = $state['smart'][$id]['counters'] ?? [];
    $save = [];
    foreach ($s['counters'] as $label => [$val, $lvl]) {
        $old = (int)($base[$label] ?? 0);    // without a baseline, a value > 0 is reported once
        if ($val > $old) {
            $events[] = [$lvl, "Disk $name: $label increased",
                "Disk $name ($dev): $label increased from $old to $val."];
        }
        $save[$label] = $val;
    }
    // also shown on the status page (last known state)
    $state['smart'][$id] = ['passed' => $s['passed'], 'wear' => $s['wear'], 'counters' => $save];
}

function sm_check_space(array $cfg, array &$issues, array &$ran): void
{
    $ran[] = 'space:';
    $w = sm_num($cfg, 'SPACE_WARN', 85);
    $c = sm_num($cfg, 'SPACE_CRIT', 95);
    foreach (sm_get_space(sm_list($cfg['SPACE_PATHS'] ?? '')) as $s) {
        $p   = $s['path'];
        $txt = sprintf('%s is %.1f %% full (free: %s).', $p, $s['pct'], sm_bytes((float)$s['free']));
        if ($s['pct'] >= $c)     $issues["space:$p"] = ['alert',   "Storage almost full: $p", $txt];
        elseif ($s['pct'] >= $w) $issues["space:$p"] = ['warning', "Storage running low: $p", $txt];
    }
}

function sm_check_docker(array $cfg, array &$state, array &$issues, array &$events, array &$ran): void
{
    $list = sm_get_docker();
    if ($list === null) return;
    $ran[] = 'docker:';

    $watch = sm_list($cfg['DOCKER_WATCH'] ?? '');
    $all   = in_array('*', $watch, true);
    $prev  = $state['docker'] ?? [];
    $now   = [];

    foreach ($list as ['name' => $n, 'state' => $st, 'status' => $status, 'unhealthy' => $bad]) {
        $now[$n] = $st;
        if ($bad) {
            $issues["docker:$n:health"] = ['warning', "Container $n: unhealthy",
                "The health check of container $n is failing ($status)."];
        }
        if (!$all && in_array($n, $watch, true) && $st !== 'running') {
            $issues["docker:$n:down"] = ['alert', "Container $n is not running",
                "Watched container $n is in state '$st' ($status)."];
        }
        if ($all && ($prev[$n] ?? '') === 'running' && $st !== 'running') {
            $events[] = ['warning', "Container $n stopped", "Container $n: $status"];
        }
    }
    foreach ($watch as $n) {
        if ($n !== '*' && !isset($now[$n])) {
            $issues["docker:$n:missing"] = ['warning', "Container $n not found",
                "The watched container $n does not exist (check the name in the settings)."];
        }
    }
    $state['docker'] = $now;
}

function sm_check_docker_updated(array &$state, array &$events): void
{
    $imgs = sm_get_docker_images();
    if ($imgs === null) return;
    $prev = $state['docker_img'] ?? [];
    $now  = [];
    foreach ($imgs as $n => $c) {
        $p = $prev[$n] ?? null;
        $e = ['id' => $c['id'], 'image' => $c['image'], 'version' => $c['version'], 'updated' => $p['updated'] ?? null];
        if (is_array($p) && $p['id'] !== $c['id']) {          // new image for an existing container
            $e['updated'] = time();
            if (sm_norm_image((string)$p['image']) !== sm_norm_image($c['image'])) {
                $events[] = ['normal', "Container $n: image changed",
                    "Container $n now uses {$c['image']} instead of {$p['image']}."];
            } else {
                $ver = ($p['version'] !== '' || $c['version'] !== '')
                    ? sprintf(' Version: %s -> %s.', $p['version'] ?: '?', $c['version'] ?: '?') : '';
                $events[] = ['normal', "Container $n updated",
                    "Container $n was started with a new image ({$c['image']}).$ver"];
            }
        }
        $now[$n] = $e;
    }
    $state['docker_img'] = $now;
}

function sm_check_vms(array $cfg, array &$state, array &$issues, array &$events, array &$ran): void
{
    $list = sm_get_vms();
    if ($list === null) return;
    $ran[] = 'vm:';

    $watch = sm_list($cfg['VM_WATCH'] ?? '');
    $all   = in_array('*', $watch, true);
    $prev  = $state['vms'] ?? [];
    $now   = [];

    foreach ($list as ['name' => $vm, 'state' => $st]) {
        $now[$vm] = $st;
        if ($st === 'crashed') {
            $issues["vm:$vm:crashed"] = ['alert', "VM $vm crashed", "VM $vm is in state 'crashed'."];
        }
        if (!$all && in_array($vm, $watch, true) && $st !== 'running') {
            $issues["vm:$vm:down"] = ['alert', "VM $vm is not running", "Watched VM $vm is in state '$st'."];
        }
        if ($all && ($prev[$vm] ?? '') === 'running' && $st !== 'running') {
            $events[] = ['warning', "VM $vm stopped", "VM $vm is now in state '$st'."];
        }
    }
    $state['vms'] = $now;
}

function sm_check_system(array $cfg, array &$state, array &$issues, array &$events, array &$ran): void
{
    $ran[] = 'sys:';
    $s = sm_get_system();

    // detect a reboot (boot_id changes on every boot)
    if ($s['boot_id'] !== '') {
        if (isset($state['boot_id']) && $state['boot_id'] !== $s['boot_id']) {
            $events[] = ['warning', 'Server was restarted',
                sprintf('The server has been up for %d min. If the restart was not planned, check the syslog.', intdiv($s['uptime'], 60))];
        }
        $state['boot_id'] = $s['boot_id'];
    }

    $w = sm_num($cfg, 'CPU_LOAD_WARN', 90);
    if ($s['load_pct'] !== null && $s['load_pct'] >= $w) {
        $issues['sys:load'] = ['warning', 'High CPU load',
            sprintf('5-minute load %.2f on %d CPUs (%.0f %%, warning from %.0f %%).', $s['load'][1], $s['cores'], $s['load_pct'], $w)];
    }

    // note: the ZFS ARC counts as used here
    $w = sm_num($cfg, 'RAM_WARN', 90);
    if ($s['mem_pct'] !== null && $s['mem_pct'] >= $w) {
        $issues['sys:ram'] = ['warning', 'Memory running low',
            sprintf('%.1f %% used, available: %s.', $s['mem_pct'], sm_bytes((float)$s['mem_avail']))];
    }
}

function sm_check_ups(array &$issues, array &$ran): void
{
    $u = sm_get_ups();
    if ($u === null) return;
    $ran[] = 'ups:';
    $st     = $u['status'];
    $detail = sprintf('Status: %s, charge: %s, time left: %s.', $st, $u['charge'] ?: '?', $u['timeleft'] ?: '?');
    if (stripos($st, 'ONBATT') !== false) {
        $issues['ups:onbatt'] = ['alert', 'Power outage: UPS on battery', $detail];
    } elseif (stripos($st, 'COMMLOST') !== false) {
        $issues['ups:comm'] = ['warning', 'Lost connection to UPS', $detail];
    }
    if (stripos($st, 'REPLACEBATT') !== false) {
        $issues['ups:battery'] = ['warning', 'Replace UPS battery', $detail];
    }
}

function sm_check_certs(array $cfg, bool $force, array &$state, array &$issues, array &$ran): void
{
    global $dry;
    // certificates rarely change: check at most once per hour
    $stamp = SM_TMP . '/lastcert';
    if (!$force && time() - (int)@file_get_contents($stamp) < 3600 - 10) {
        sm_keep($state, $issues, 'cert:');
        return;
    }
    if (!$dry) file_put_contents($stamp, (string)time());

    $now    = time();
    $warn   = sm_num($cfg, 'CERT_WARN_DAYS', 20);
    $crit   = sm_num($cfg, 'CERT_CRIT_DAYS', 7);
    $ignore = array_map('strtolower', sm_list($cfg['CERT_IGNORE'] ?? ''));
    $items  = [];   // for the status page

    $grade = function (int $exp) use ($now, $warn, $crit): array {
        $days = (int)floor(($exp - $now) / 86400);
        if ($exp <= $now)    return [$days, 'alert', 'has expired'];
        if ($days <= $crit)  return [$days, 'alert', "expires in $days days"];
        if ($days <= $warn)  return [$days, 'warning', "expires in $days days"];
        return [$days, null, "valid, $days days left"];
    };

    // --- certificate files
    $fileCerts = [];
    $dirs = sm_list($cfg['CERT_DIRS'] ?? '');
    if ($dirs) {
        $ran[] = 'cert:file:';
        $res   = sm_get_cert_files($dirs);
        foreach ($res['missing'] as $d) {
            $issues["cert:file:missing:$d"] = ['warning', 'Certificate directory not found',
                "The directory $d does not exist. Check the path in the settings (CERT_DIRS)."];
        }
        // Detect superseded certificates: another certificate covers all names and expires later.
        // When a certificate is recreated, NPM creates a new npm-<id> directory; the old one may remain.
        $valid = array_filter($res['certs'], fn($x) => !isset($x['error']));
        $supersededBy = function (array $c) use ($valid): ?string {
            foreach ($valid as $o) {
                if ($o['id'] === $c['id'] || $o['expires'] <= $c['expires']) continue;
                $all = true;
                foreach ($c['names'] as $n) { if (!sm_cert_covers($o['names'], $n)) { $all = false; break; } }
                if ($all && $c['names']) return $o['id'];
            }
            return null;
        };
        foreach ($res['certs'] as $c) {
            $label = isset($c['names'][0]) ? $c['names'][0] : $c['id'];
            if (isset($c['error'])) {
                $issues["cert:file:{$c['id']}"] = ['warning', "Certificate $label not readable", "File: {$c['path']}"];
                $items[] = ['source' => 'File', 'name' => $label, 'id' => $c['id'], 'error' => $c['error']];
                continue;
            }
            if (array_intersect(array_map('strtolower', $c['names']), $ignore)) continue;
            $fileCerts[] = $c;
            $newer = $supersededBy($c);
            if ($newer !== null) {
                $items[] = ['source' => 'File', 'name' => $label, 'id' => $c['id'], 'names' => $c['names'],
                            'issuer' => $c['issuer'], 'expires' => $c['expires'],
                            'days' => (int)floor(($c['expires'] - $now) / 86400), 'level' => null,
                            'superseded' => $newer];
                continue;
            }
            [$days, $lvl, $txt] = $grade($c['expires']);
            if ($lvl !== null) {
                $issues["cert:file:{$c['id']}"] = [$lvl, "Certificate $label $txt",
                    sprintf('Certificate for %s (%s, issuer %s) valid until %s. Let\'s Encrypt normally renews 30 days before expiry; check the renewal in Nginx Proxy Manager.',
                        implode(', ', $c['names']), $c['id'], $c['issuer'] ?: '?', date('Y-m-d H:i', $c['expires']))];
            }
            $items[] = ['source' => 'File', 'name' => $label, 'id' => $c['id'], 'names' => $c['names'],
                        'issuer' => $c['issuer'], 'expires' => $c['expires'], 'days' => $days, 'level' => $lvl];
        }
    }

    // --- served certificates
    $hosts = sm_list($cfg['CERT_HOSTS'] ?? '');
    if ($hosts) {
        $ran[] = 'cert:live:';
        foreach ($hosts as $entry) {
            $r = sm_get_cert_live($entry);
            $h = $r['host'];
            if ($r['error'] !== null) {
                $hint = $r['addr'] === $h
                    ? " If the server cannot reach its public address (no NAT loopback on the router), enter it as $h@<LAN-IP>:<NPM-HTTPS-port>."
                    : ' Is Nginx Proxy Manager running and is the port correct?';
                $issues["cert:live:$h:conn"] = ['warning', "TLS check for $h failed", $r['error'] . '.' . $hint];
                $items[] = ['source' => 'Live', 'name' => $h, 'error' => $r['error']];
                continue;
            }
            [$days, $lvl, $txt] = $grade($r['expires']);
            if ($lvl !== null) {
                $issues["cert:live:$h:expiry"] = [$lvl, "Served certificate for $h $txt",
                    sprintf('%s:%d serves a certificate (issuer %s) valid until %s.',
                        $r['addr'], $r['port'], $r['issuer'] ?: '?', date('Y-m-d H:i', $r['expires']))];
            }
            $verr = null;
            if (sm_on($cfg, 'CERT_VERIFY') && $r['verify'] !== null && $r['verify']['code'] !== 0) {
                $verr = $r['verify']['text'];
                $issues["cert:live:$h:verify"] = ['warning', "Certificate for $h not trusted",
                    "Verification reports: $verr (code {$r['verify']['code']}). Causes: wrong hostname, missing intermediate certificates or a self-signed certificate."];
            }
            // compare with the file: is nginx still serving an older certificate?
            $stale = false;
            foreach ($fileCerts as $fc) {
                if (sm_cert_covers($fc['names'], $h) && $fc['expires'] > $r['expires'] + 86400) {
                    $stale = true;
                    $issues["cert:live:$h:stale"] = ['warning', "Outdated certificate served for $h",
                        sprintf('A certificate valid until %s exists on disk, but one valid until %s is being served. Nginx Proxy Manager probably did not load the renewal; restart the container.',
                            date('Y-m-d', $fc['expires']), date('Y-m-d', $r['expires']))];
                    break;
                }
            }
            $items[] = ['source' => 'Live', 'name' => $h, 'names' => $r['names'], 'issuer' => $r['issuer'],
                        'expires' => $r['expires'], 'days' => $days, 'level' => $lvl,
                        'verify' => $verr, 'stale' => $stale];
        }
    }

    if (!$dry) {
        @file_put_contents(SM_TMP . '/certs.json',
            json_encode(['time' => $now, 'items' => $items], JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE));
    }
}

function sm_check_updates(array &$state, array &$events): void
{
    $avail = sm_get_updates();
    if ($avail === null) return;
    $new = array_values(array_diff($avail, $state['updates'] ?? []));
    if ($new) {
        // map images to containers so the notification names the containers
        $items = [];
        foreach ($new as $img) {
            $names = [];
            foreach ($state['docker_img'] ?? [] as $n => $c) {
                if (sm_norm_image((string)$c['image']) === sm_norm_image($img)) $names[] = $n;
            }
            $items[] = $names ? implode(', ', $names) . " ($img)" : $img;
        }
        $events[] = ['normal', count($new) . ' Docker update(s) available',
            implode('; ', $items) . '. Update via the Docker tab.'];
    }
    $state['updates'] = $avail;
}

/** Reports every new Unraid OS version once. Versions ignored in the Update OS dialog are skipped. */
function sm_check_os_update(array &$state, array &$events): void
{
    $u = sm_get_os_update();
    if ($u === null || $u['error'] !== null) return;   // no or failed check: keep the last state
    $ver = ($u['version'] !== null && !$u['ignored']) ? $u['version'] : '';
    if ($ver !== '' && $ver !== ($state['os_update'] ?? '')) {
        $events[] = ['normal', "Unraid OS $ver available",
            "Installed: {$u['current']}. Update via Tools > Update OS; read the release notes first."];
    }
    $state['os_update'] = $ver;
}

/** Reports every new plugin version once, all plugins of a run in one notification. */
function sm_check_plugin_updates(array &$state, array &$events): void
{
    $p = sm_get_plugin_updates();
    if ($p === null) return;
    $prev  = $state['plugin_updates'] ?? [];
    $now   = [];
    $items = [];
    foreach ($p['updates'] as $name => $v) {
        $now[$name] = $v['available'];
        if (($prev[$name] ?? '') !== $v['available']) $items[] = "$name {$v['installed']} -> {$v['available']}";
    }
    if ($items) {
        $events[] = ['normal', count($items) . ' plugin update(s) available',
            implode('; ', $items) . '. Update via the Plugins tab.'];
    }
    $state['plugin_updates'] = $now;
}

// ================================================================== Helpers

function sm_send(string $lvl, string $subj, string $desc, bool $forceHook = false): void
{
    global $dry, $cfg, $smHookSent, $smHookSkipped;
    $url  = trim((string)($cfg['WEBHOOK_URL'] ?? ''));
    $hook = $url !== '' && ($forceHook || sm_rank($lvl) >= sm_rank((string)($cfg['WEBHOOK_LEVEL'] ?? 'warning')));
    if ($dry) { echo "[$lvl] $subj - $desc" . ($hook ? ' [+Webhook]' : '') . "\n"; return; }

    exec(SM_NOTIFY
        . ' -e ' . escapeshellarg('Server Monitor')
        . ' -s ' . escapeshellarg("srvmon: $subj")
        . ' -d ' . escapeshellarg($desc)
        . ' -i ' . escapeshellarg($lvl)
        . ' >/dev/null 2>&1');
    exec('logger -t srvmon ' . escapeshellarg("[$lvl] $subj - $desc"));

    if (!$hook) return;
    if ((int)$smHookSent >= SM_MAX_HOOKS) { $smHookSkipped = (int)$smHookSkipped + 1; return; }
    $smHookSent = (int)$smHookSent + 1;
    $host  = gethostname() ?: 'Unraid';
    $intro = ['alert' => 'Alert', 'warning' => 'Warning'][$lvl] ?? 'Notice';
    sm_webhook($url, [
        'level' => $lvl, 'subject' => $subj, 'description' => $desc,
        'speech' => "$intro from server $host: $subj",
        'host' => $host, 'time' => time(),
    ]);
}

/** After sending: summarise skipped webhook notifications in one call. */
function sm_webhook_flush(): void
{
    global $dry, $cfg, $smHookSkipped;
    if ($dry || (int)$smHookSkipped === 0) return;
    $host = gethostname() ?: 'Unraid';
    sm_webhook(trim((string)$cfg['WEBHOOK_URL']), [
        'level' => 'warning', 'subject' => "$smHookSkipped more notifications",
        'description' => 'Details in the Unraid notifications.',
        'speech' => "Server $host has $smHookSkipped more notifications. Details in Unraid.",
        'host' => $host, 'time' => time(),
    ]);
}

function sm_webhook(string $url, array $payload): void
{
    $json = json_encode($payload, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES);
    $out = []; $rc = 0;
    exec('curl -fsS -m 10 -X POST -H ' . escapeshellarg('Content-Type: application/json')
         . ' --data-binary ' . escapeshellarg((string)$json) . ' ' . escapeshellarg($url) . ' 2>&1', $out, $rc);
    if ($rc !== 0) {
        // webhook target unreachable (e.g. Home Assistant stopped): log only,
        // the Unraid notification has already been sent.
        exec('logger -t srvmon ' . escapeshellarg('Webhook failed (curl ' . $rc . '): ' . implode(' ', $out)));
    }
}

function sm_keep(array $state, array &$issues, string $prefix): void
{
    foreach ($state['issues'] ?? [] as $k => $p) {
        if (strncmp((string)$k, $prefix, strlen($prefix)) === 0) {
            $issues[$k] = [(string)$p['level'], (string)$p['subject'], (string)$p['desc']];
        }
    }
}

function sm_prefix_ran(string $key, array $ran): bool
{
    foreach ($ran as $p) if (strncmp($key, $p, strlen($p)) === 0) return true;
    return false;
}

function sm_rank(string $l): int
{
    return ['normal' => 0, 'warning' => 1, 'alert' => 2][$l] ?? 0;
}
]]></INLINE>
</FILE>

<FILE Name="&emhttp;/srvmon.page">
<INLINE><![CDATA[Menu="Utilities"
Title="Server Monitor"
Icon="heartbeat"
---
<?php
$sm = array_merge(
    @parse_ini_file('/usr/local/emhttp/plugins/srvmon/default.cfg') ?: [],
    @parse_ini_file('/boot/config/plugins/srvmon/srvmon.cfg') ?: []
);
$smStatus = json_decode((string)@file_get_contents('/tmp/srvmon/status.json'), true) ?: [];
if (!function_exists('sm_v')) {
    function sm_v(array $c, string $k): string {
        return htmlspecialchars((string)($c[$k] ?? ''), ENT_QUOTES);
    }
    function sm_lvl(array $c, string $k): string {
        $cur = (string)($c[$k] ?? 'warning');
        $o = '';
        foreach (['normal' => 'Everything (from Notice)', 'warning' => 'Warnings and alerts', 'alert' => 'Alerts only'] as $v => $t) {
            $o .= '<option value="' . $v . '"' . ($cur === $v ? ' selected' : '') . '>' . $t . '</option>';
        }
        return '<select name="' . $k . '">' . $o . '</select>';
    }
    function sm_yn(array $c, string $k): string {
        $on = in_array(strtolower((string)($c[$k] ?? '')), ['1', 'yes', 'true', 'on'], true);
        return '<select name="' . $k . '">'
             . '<option value="yes"' . ($on ? ' selected' : '') . '>Yes</option>'
             . '<option value="no"'  . ($on ? '' : ' selected') . '>No</option></select>';
    }
}
?>
<style>
.srvmon-sec{font-weight:bold;font-size:1.1em;margin:2.2em 0 .9em;padding-bottom:.35em;border-bottom:1px solid rgba(127,127,127,.4)}
.srvmon-sec.first{margin-top:.5em}
.srvmon-sec small{font-weight:normal;opacity:.7;margin-left:.6em}
</style>
<div style="margin:0 0 1.5em 0">
<p><b>Last run:</b> <?= isset($smStatus['lastrun']) ? date('Y-m-d H:i:s', (int)$smStatus['lastrun']) : 'none yet' ?></p>
<?php if (empty($smStatus['issues'])): ?>
<p>No active problems.</p>
<?php else: ?>
<table class="tablesorter"><thead><tr><th>Level</th><th>Problem</th><th>Since</th></tr></thead><tbody>
<?php foreach ($smStatus['issues'] as $i): ?>
<tr><td><?= htmlspecialchars((string)$i['level']) ?></td><td><?= htmlspecialchars((string)$i['subject']) ?><br><small><?= htmlspecialchars((string)$i['desc']) ?></small></td><td><?= date('Y-m-d H:i', (int)$i['since']) ?></td></tr>
<?php endforeach; ?>
</tbody></table>
<?php endif; ?>
<p><small>Emails are sent by Unraid's notification system. Configure SMTP and the email agents per level under Settings &gt; Notifications. Update notifications have the level Notice: to receive them by email, enable the email agent for Notices there. Available Docker, Unraid OS and plugin updates come from Unraid's own update checks; their schedules are also set under Settings &gt; Notifications.</small></p>
</div>

<form markdown="1" name="srvmon_settings" method="POST" action="/update.php" target="progressFrame">
<input type="hidden" name="#file" value="srvmon/srvmon.cfg">
<input type="hidden" name="csrf_token" value="<?=htmlspecialchars((string)($var['csrf_token'] ?? ''), ENT_QUOTES)?>">

<div class="srvmon-sec first">General</div>

Check interval (minutes):
: <input type="number" name="INTERVAL" min="1" max="1440" value="<?=sm_v($sm,'INTERVAL')?>">

Reminder for ongoing problems (hours, 0 = off):
: <input type="number" name="REMIND_HOURS" min="0" value="<?=sm_v($sm,'REMIND_HOURS')?>" style="width:6em">

Notify when a problem is resolved:
: <?=sm_yn($sm,'NOTIFY_RESOLVED')?>

<div class="srvmon-sec">Disks and SMART</div>

Check disks (status, errors, temperature):
: <?=sm_yn($sm,'CHECK_DISKS')?>

Check SMART values (does not wake disks):
: <?=sm_yn($sm,'CHECK_SMART')?>

HDD temperature warning / critical (°C):
: <input type="number" name="TEMP_HDD_WARN" value="<?=sm_v($sm,'TEMP_HDD_WARN')?>" style="width:6em"> <input type="number" name="TEMP_HDD_CRIT" value="<?=sm_v($sm,'TEMP_HDD_CRIT')?>" style="width:6em">

NVMe temperature warning / critical (°C):
: <input type="number" name="TEMP_NVME_WARN" value="<?=sm_v($sm,'TEMP_NVME_WARN')?>" style="width:6em"> <input type="number" name="TEMP_NVME_CRIT" value="<?=sm_v($sm,'TEMP_NVME_CRIT')?>" style="width:6em">

<div class="srvmon-sec">Storage space</div>

Check storage space:
: <?=sm_yn($sm,'CHECK_SPACE')?>

Paths (comma-separated):
: <input type="text" name="SPACE_PATHS" value="<?=sm_v($sm,'SPACE_PATHS')?>" style="width:30em">

Usage warning / critical (%):
: <input type="number" name="SPACE_WARN" min="1" max="100" value="<?=sm_v($sm,'SPACE_WARN')?>" style="width:6em"> <input type="number" name="SPACE_CRIT" min="1" max="100" value="<?=sm_v($sm,'SPACE_CRIT')?>" style="width:6em">

<div class="srvmon-sec">Docker</div>

Check containers:
: <?=sm_yn($sm,'CHECK_DOCKER')?>

Watched containers:
: <input type="text" name="DOCKER_WATCH" value="<?=sm_v($sm,'DOCKER_WATCH')?>" style="width:30em" placeholder="* or names, comma-separated">

Notify about available updates:
: <?=sm_yn($sm,'CHECK_UPDATES')?>

Notify about performed updates:
: <?=sm_yn($sm,'CHECK_DOCKER_UPDATED')?>

<div class="srvmon-sec">Unraid OS and plugins<small>uses the result of Unraid's own update checks</small></div>

Notify about Unraid OS updates:
: <?=sm_yn($sm,'CHECK_OS_UPDATES')?>

Notify about plugin updates:
: <?=sm_yn($sm,'CHECK_PLUGIN_UPDATES')?>

<div class="srvmon-sec">VMs</div>

Check VMs:
: <?=sm_yn($sm,'CHECK_VMS')?>

Watched VMs:
: <input type="text" name="VM_WATCH" value="<?=sm_v($sm,'VM_WATCH')?>" style="width:30em" placeholder="* or names, comma-separated">

<div class="srvmon-sec">System and UPS</div>

Check system (CPU, RAM, reboot):
: <?=sm_yn($sm,'CHECK_SYSTEM')?>

CPU load warning (% of cores):
: <input type="number" name="CPU_LOAD_WARN" min="1" value="<?=sm_v($sm,'CPU_LOAD_WARN')?>" style="width:6em">

RAM usage warning (%):
: <input type="number" name="RAM_WARN" min="1" max="100" value="<?=sm_v($sm,'RAM_WARN')?>" style="width:6em">

Check UPS (apcupsd):
: <?=sm_yn($sm,'CHECK_UPS')?>

<div class="srvmon-sec">TLS certificates<small>checked at most once per hour</small></div>

Check certificates:
: <?=sm_yn($sm,'CHECK_CERTS')?>

Certificate directories (comma-separated):
: <input type="text" name="CERT_DIRS" value="<?=sm_v($sm,'CERT_DIRS')?>" style="width:30em" placeholder="/mnt/user/appdata/NginxProxyManager/letsencrypt/live">

Hosts to check live (comma-separated):
: <input type="text" name="CERT_HOSTS" value="<?=sm_v($sm,'CERT_HOSTS')?>" style="width:30em" placeholder="cloud.example.com@192.168.1.10:443">

Expiry warning / critical (days before):
: <input type="number" name="CERT_WARN_DAYS" min="1" value="<?=sm_v($sm,'CERT_WARN_DAYS')?>" style="width:6em"> <input type="number" name="CERT_CRIT_DAYS" min="0" value="<?=sm_v($sm,'CERT_CRIT_DAYS')?>" style="width:6em">

Verify trust chain and hostname:
: <?=sm_yn($sm,'CERT_VERIFY')?>

Ignored domains (comma-separated):
: <input type="text" name="CERT_IGNORE" value="<?=sm_v($sm,'CERT_IGNORE')?>" style="width:30em">

<div class="srvmon-sec">Additional notification channels<small>in addition to Unraid's notifications</small></div>

Webhook URL (e.g. Home Assistant):
: <input type="text" name="WEBHOOK_URL" value="<?=sm_v($sm,'WEBHOOK_URL')?>" style="width:30em" placeholder="http://192.168.1.20:8123/api/webhook/srvmon-...">

Send webhook for:
: <?=sm_lvl($sm,'WEBHOOK_LEVEL')?>

Heartbeat URL (external outage monitoring):
: <input type="text" name="HEARTBEAT_URL" value="<?=sm_v($sm,'HEARTBEAT_URL')?>" style="width:30em" placeholder="https://hc-ping.com/...">

<div class="srvmon-sec"></div>

&nbsp;
: <input type="submit" value="Apply"><input type="button" value="Done" onclick="done()">
</form>
