<?xml version="1.0" standalone="yes"?>
<!DOCTYPE PLUGIN [
<!ENTITY name      "srvmon">
<!ENTITY author    "MarioKonang">
<!ENTITY version   "2026.10.18o">
<!ENTITY repo      "https://github.com/MarioKonang/unraid-srvmon">
<!ENTITY pluginURL "https://raw.githubusercontent.com/MarioKonang/unraid-srvmon/main/srvmon.plg">
<!ENTITY emhttp    "/usr/local/emhttp/plugins/&name;">
<!ENTITY plgpath   "/boot/config/plugins/&name;">
]>
<PLUGIN name="&name;" author="&author;" version="&version;" pluginURL="&pluginURL;" min="6.12.0" icon="heartbeat" launch="Settings/srvmon" support="&repo;">

<CHANGES>
###2026.10.18o
- Reachability from the internet via UptimeRobot: monitors are created and deleted by srvmon (presets for Nextcloud and Immich), outages are reported through the srvmon notification chain
- Local diagnosis during an outage via Nginx Proxy Manager
- Status page: new card "Reachability from the internet"
- New options CHECK_EXTERNAL, UPTIMEROBOT_KEY and EXT_MONITORS

###2026.10.18n
- Notification when a plugin was updated (installed version changed), all plugins of a run in one notification
- Status page: plugins updated in the last 7 days
- New option CHECK_PLUGIN_UPDATED
- Language of the notifications selectable (English, German, French, Spanish), separately for Unraid notifications and webhook

###2026.10.18m
- Fix: updates via the Plugins tab did not replace the program files, so the previous version kept running. Old program files are now removed before installation.
- Unraid OS update: hint if the update period of the license has ended (isEligible), also on the status page

###2026.10.18l
- Notification about available Unraid OS and plugin updates (from Unraid's own update checks, once per new version)
- Status page: new card "Unraid OS and plugins"
- New options CHECK_OS_UPDATES and CHECK_PLUGIN_UPDATES

###2026.10.18k
- All texts (user interface, notifications, documentation) translated to English
- Dates shown in ISO format (YYYY-MM-DD)

###2026.10.18j
- Published on GitHub, updates via the Plugins tab

###2026.10.18i
- Webhook delivery (e.g. to Home Assistant for Alexa announcements), minimum level configurable, max. 3 calls per run
- Heartbeat URL for external outage monitoring (healthchecks.io, Uptime Kuma)

###2026.10.18h
- Settings page grouped into sections

###2026.10.18g
- Certificate files superseded by a newer certificate for the same domains are ignored
- Hint about the host@LAN-IP:port notation when the live check cannot connect

###2026.10.18f
- Empty disk slots without device and ID are ignored (false alarm for an empty parity2 slot with DISK_NP_DSBL)

###2026.10.18e
- Cron entry is reloaded after the installation has finished (it was missing after installation before)
- Icon, description and link to the settings page in the plugin list

###2026.10.18d
- TLS certificates: expiry of certificate files (Nginx Proxy Manager) and of live served certificates
- Detection of nginx still serving the old certificate after a renewal
- Trust chain and hostname verification, certificate overview on the status page

###2026.10.18c
- Notification when a container was started with a new image (incl. version from image labels)
- Notification about available updates names the affected containers
- Status page: update hint, version and time of last update per container
- New option CHECK_DOCKER_UPDATED

###2026.10.18b
- New page "Server Monitor Status" with live view (refresh every 30 s)
- Data collection moved to include/lib.php, JSON endpoint include/data.php

###2026.10.18a
- CSRF token set explicitly in the settings form

###2026.10.18
- First version: disks, SMART, storage, Docker, VMs, system, UPS, Docker updates
</CHANGES>

<!-- Unraid's plugin manager does not overwrite existing files on update.
     Remove the old program files first so the INLINE files below are written fresh.
     Configuration and state live in &plgpath; and are not touched. -->
<FILE Run="/bin/bash">
<INLINE>
rm -rf &emhttp;
</INLINE>
</FILE>

<FILE Name="&emhttp;/README.md">
<INLINE><![CDATA[**Server Monitor (srvmon)**

Monitors disks, SMART, storage space, Docker containers and updates, Unraid OS and plugin updates, VMs, system, UPS and TLS certificates and reports problems via Unraid's notifications. Settings and live status under Settings > User Utilities.
]]></INLINE>
</FILE>

<FILE Name="&emhttp;/default.cfg">
<INLINE><![CDATA[INTERVAL="5"
CHECK_DISKS="yes"
CHECK_SMART="yes"
CHECK_SPACE="yes"
CHECK_DOCKER="yes"
CHECK_VMS="yes"
CHECK_SYSTEM="yes"
CHECK_UPS="yes"
CHECK_UPDATES="yes"
CHECK_DOCKER_UPDATED="yes"
CHECK_OS_UPDATES="yes"
CHECK_PLUGIN_UPDATES="yes"
CHECK_PLUGIN_UPDATED="yes"
TEMP_HDD_WARN="45"
TEMP_HDD_CRIT="50"
TEMP_NVME_WARN="60"
TEMP_NVME_CRIT="70"
SPACE_PATHS="/mnt/user,/mnt/cache,/var/log,/var/lib/docker"
SPACE_WARN="85"
SPACE_CRIT="95"
DOCKER_WATCH="*"
VM_WATCH=""
CPU_LOAD_WARN="90"
RAM_WARN="90"
REMIND_HOURS="24"
NOTIFY_RESOLVED="yes"
NOTIFY_LANG="en"
CHECK_CERTS="yes"
CERT_DIRS="/mnt/user/appdata/NginxProxyManager/letsencrypt/live"
CERT_HOSTS=""
CERT_WARN_DAYS="20"
CERT_CRIT_DAYS="7"
CERT_VERIFY="yes"
CERT_IGNORE=""
CHECK_EXTERNAL="no"
UPTIMEROBOT_KEY=""
EXT_MONITORS=""
WEBHOOK_URL=""
WEBHOOK_LEVEL="warning"
WEBHOOK_LANG="en"
HEARTBEAT_URL=""
]]></INLINE>
</FILE>

<FILE Name="&emhttp;/include/lib.php">
<INLINE><![CDATA[<?php
/*
 * srvmon - shared functions for check.php (checks) and data.php (status page)
 */
declare(strict_types=1);

const SM_DEF_CFG     = '/usr/local/emhttp/plugins/srvmon/default.cfg';
const SM_USR_CFG     = '/boot/config/plugins/srvmon/srvmon.cfg';
const SM_STATE       = '/boot/config/plugins/srvmon/state.json';   // flash: written only on change
const SM_TMP         = '/tmp/srvmon';                              // RAM
const SM_NOTIFY      = '/usr/local/emhttp/webGui/scripts/notify';
const SM_DISKS_INI   = '/var/local/emhttp/disks.ini';
const SM_DOCKER_UPD  = '/var/lib/docker/unraid-update-status.json';
const SM_OS_VERSION  = '/etc/unraid-version';
const SM_OS_CHECK    = '/tmp/unraidcheck/result.json';    // result of Unraid's OS update check
const SM_OS_IGNORED  = '/tmp/unraidcheck/ignored.json';   // releases ignored in the Update OS dialog
const SM_PLG_NEW     = '/tmp/plugins';                    // .plg files downloaded by Unraid's plugin check
const SM_PLG_LOCAL   = '/var/log/plugins';                // installed plugins

// Watched ATA counters: id => [label, level on increase]
const SM_ATA_WATCH = [
    5   => ['Reallocated_Sector_Ct',  'alert'],
    187 => ['Reported_Uncorrect',     'alert'],
    197 => ['Current_Pending_Sector', 'alert'],
    198 => ['Offline_Uncorrectable',  'alert'],
    199 => ['UDMA_CRC_Error_Count',   'warning'],   // usually cable/backplane
];

// ------------------------------------------------------------ Configuration

function sm_load_cfg(): array
{
    $def = @parse_ini_file(SM_DEF_CFG) ?: [];
    $usr = is_file(SM_USR_CFG) ? (@parse_ini_file(SM_USR_CFG) ?: []) : [];
    return array_merge($def, $usr);
}

function sm_load_state(): array
{
    $j = json_decode((string)@file_get_contents(SM_STATE), true);
    return is_array($j) ? $j : [];
}

function sm_save_state(array $state): void
{
    $json = json_encode($state, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE);
    if ($json === false || @file_get_contents(SM_STATE) === $json) return;   // spare the flash drive
    @mkdir(dirname(SM_STATE), 0755, true);
    if (@file_put_contents(SM_STATE . '.tmp', $json) !== false) @rename(SM_STATE . '.tmp', SM_STATE);
}

// parse_ini_file turns yes/no into "1"/"", so evaluate leniently
function sm_on(array $c, string $k): bool
{
    return in_array(strtolower(trim((string)($c[$k] ?? ''))), ['1', 'yes', 'true', 'on'], true);
}

function sm_num(array $c, string $k, float $def): float
{
    $v = $c[$k] ?? '';
    return is_numeric($v) ? (float)$v : $def;
}

function sm_list($v): array
{
    return array_values(array_filter(array_map('trim', explode(',', (string)$v)), 'strlen'));
}

function sm_bytes(float $b): string
{
    $u = ['B', 'KB', 'MB', 'GB', 'TB', 'PB'];
    $i = 0;
    while ($b >= 1024 && $i < count($u) - 1) { $b /= 1024; $i++; }
    return sprintf('%.1f %s', $b, $u[$i]);
}

// ------------------------------------------------------------ Data collectors
// Each collector returns null if its source is unavailable.

function sm_get_disks(): ?array
{
    $ini = @parse_ini_file(SM_DISKS_INI, true);
    if (!is_array($ini)) return null;
    $r = [];
    foreach ($ini as $sec => $d) {
        if (!is_array($d)) continue;
        $status = (string)($d['status'] ?? '');
        $dev    = (string)($d['device'] ?? '');
        if ($status === '' || $status === 'DISK_NP') continue;   // empty slot
        // Unassigned slot without device and ID (e.g. empty parity2 slot reported as DISK_NP_DSBL).
        // An assigned but missing disk keeps its ID and is still reported.
        if ($dev === '' && trim((string)($d['id'] ?? '')) === '') continue;
        $temp = $d['temp'] ?? '';
        $r[] = [
            'name'   => (string)($d['name'] ?? $sec),
            'device' => $dev,
            'id'     => (string)($d['id'] ?? $dev),
            'status' => $status,
            'type'   => (string)($d['type'] ?? ''),
            'temp'   => is_numeric($temp) ? (float)$temp : null,   // null = spun down / unknown
            'errors' => (int)($d['numErrors'] ?? 0),
            'nvme'   => strncmp($dev, 'nvme', 4) === 0,
        ];
    }
    return $r;
}

/** Read SMART without waking sleeping disks. null = standby or unreadable. */
function sm_get_smart(string $dev): ?array
{
    $out = []; $rc = 0;
    exec('timeout 60 smartctl -n standby -j -H -A ' . escapeshellarg("/dev/$dev") . ' 2>/dev/null', $out, $rc);
    $j = json_decode(implode("\n", $out), true);
    if (!is_array($j) || !isset($j['smart_status']['passed'])) return null;

    $res = ['passed' => $j['smart_status']['passed'] === true, 'counters' => [], 'nvme_cw' => null, 'wear' => null];
    foreach ($j['ata_smart_attributes']['table'] ?? [] as $a) {
        $aid = (int)($a['id'] ?? 0);
        if (isset(SM_ATA_WATCH[$aid])) {
            $res['counters'][SM_ATA_WATCH[$aid][0]] = [(int)($a['raw']['value'] ?? 0), SM_ATA_WATCH[$aid][1]];
        }
    }
    $nv = $j['nvme_smart_health_information_log'] ?? null;
    if (is_array($nv)) {
        $res['counters']['Media_Errors'] = [(int)($nv['media_errors'] ?? 0), 'alert'];
        $res['nvme_cw'] = (int)($nv['critical_warning'] ?? 0);
        $res['wear']    = (int)($nv['percentage_used'] ?? 0);
    }
    return $res;
}

function sm_mounted(string $p): bool
{
    $o = []; $rc = 0;
    exec('mountpoint -q ' . escapeshellarg($p) . ' 2>/dev/null', $o, $rc);
    return $rc === 0;
}

function sm_get_space(array $paths): array
{
    $r = [];
    foreach ($paths as $p) {
        if (!sm_mounted($p)) continue;          // not mounted (e.g. array stopped)
        $t = @disk_total_space($p);
        $f = @disk_free_space($p);
        if (!$t || $f === false) continue;
        $r[] = ['path' => $p, 'total' => $t, 'free' => $f, 'pct' => round(100.0 * (1 - $f / $t), 1)];
    }
    return $r;
}

function sm_get_docker(): ?array
{
    $out = []; $rc = 0;
    exec("timeout 30 docker ps -a --format '{{.Names}}\t{{.State}}\t{{.Status}}' 2>/dev/null", $out, $rc);
    if ($rc !== 0) return null;                 // Docker service off or unreachable
    $r = [];
    foreach ($out as $line) {
        $f = explode("\t", $line);
        if (count($f) < 3) continue;
        $r[] = ['name' => $f[0], 'state' => $f[1], 'status' => $f[2],
                'unhealthy' => stripos($f[2], '(unhealthy)') !== false];
    }
    usort($r, fn($a, $b) => strcasecmp($a['name'], $b['name']));
    return $r;
}

function sm_get_vms(): ?array
{
    $out = []; $rc = 0;
    exec('timeout 30 virsh list --all --name 2>/dev/null', $out, $rc);
    if ($rc !== 0) return null;                 // VM service off
    $r = [];
    foreach (array_filter(array_map('trim', $out), 'strlen') as $vm) {
        $st  = trim((string)shell_exec('timeout 10 virsh domstate ' . escapeshellarg($vm) . ' 2>/dev/null'));
        $r[] = ['name' => $vm, 'state' => $st];
    }
    usort($r, fn($a, $b) => strcasecmp($a['name'], $b['name']));
    return $r;
}

function sm_get_system(): array
{
    $la    = explode(' ', (string)@file_get_contents('/proc/loadavg'));
    $cores = max(1, (int)trim((string)shell_exec('nproc 2>/dev/null')));
    $mi    = [];
    foreach (@file('/proc/meminfo') ?: [] as $l) {
        if (preg_match('/^(\w+):\s+(\d+)/', $l, $m)) $mi[$m[1]] = (int)$m[2] * 1024;
    }
    $total = $mi['MemTotal'] ?? 0;
    $avail = $mi['MemAvailable'] ?? null;
    $load5 = isset($la[1]) && is_numeric($la[1]) ? (float)$la[1] : null;
    return [
        'load'      => [isset($la[0]) && is_numeric($la[0]) ? (float)$la[0] : null, $load5,
                        isset($la[2]) && is_numeric($la[2]) ? (float)$la[2] : null],
        'cores'     => $cores,
        'load_pct'  => $load5 === null ? null : round($load5 / $cores * 100, 1),
        'mem_total' => $total,
        'mem_avail' => $avail,
        'mem_pct'   => ($total > 0 && $avail !== null) ? round(100.0 * (1 - $avail / $total), 1) : null,
        'uptime'    => (int)(float)explode(' ', (string)@file_get_contents('/proc/uptime'))[0],
        'boot_id'   => trim((string)@file_get_contents('/proc/sys/kernel/random/boot_id')),
    ];
}

function sm_get_ups(): ?array
{
    $out = []; $rc = 0;
    exec('timeout 10 apcaccess status 2>/dev/null', $out, $rc);
    if ($rc !== 0 || !$out) return null;        // apcupsd not running
    $u = [];
    foreach ($out as $l) {
        $p = strpos($l, ':');
        if ($p !== false) $u[trim(substr($l, 0, $p))] = trim(substr($l, $p + 1));
    }
    return ['status' => $u['STATUS'] ?? '', 'charge' => $u['BCHARGE'] ?? '',
            'timeleft' => $u['TIMELEFT'] ?? '', 'load' => $u['LOADPCT'] ?? '', 'model' => $u['MODEL'] ?? ''];
}

/**
 * Image information per container: image ID, image reference and version from labels.
 * Used to detect performed updates (new image ID for the same container).
 */
function sm_get_docker_images(): ?array
{
    $ids = []; $rc = 0;
    exec('timeout 30 docker ps -aq 2>/dev/null', $ids, $rc);
    if ($rc !== 0) return null;
    $ids = array_filter(array_map('trim', $ids), 'strlen');
    if (!$ids) return [];
    $out = [];
    $fmt = '{{.Name}}\t{{.Image}}\t{{.Config.Image}}\t{{json .Config.Labels}}';
    exec('timeout 60 docker inspect --format ' . escapeshellarg($fmt) . ' '
         . implode(' ', array_map('escapeshellarg', $ids)) . ' 2>/dev/null', $out, $rc);
    if ($rc !== 0) return null;              // e.g. container removed meanwhile: retry next run
    $r = [];
    foreach ($out as $line) {
        $f = explode("\t", $line, 4);
        if (count($f) < 4) continue;
        $labels  = json_decode($f[3], true);
        $labels  = is_array($labels) ? $labels : [];
        $version = (string)($labels['org.opencontainers.image.version'] ?? $labels['version'] ?? $labels['build_version'] ?? '');
        $r[ltrim($f[0], '/')] = ['id' => $f[1], 'image' => $f[2], 'version' => preg_match('/^.{0,80}/us', trim($version), $m) ? $m[0] : ''];
    }
    return $r;
}

/** Normalise an image reference: a missing tag becomes :latest. */
function sm_norm_image(string $ref): string
{
    $ref  = trim($ref);
    if ($ref === '' || strpos($ref, '@') !== false) return $ref;
    $last = substr($ref, (int)strrpos('/' . $ref, '/'));
    return strpos($last, ':') === false ? "$ref:latest" : $ref;
}

/** Reads Unraid's own Docker update check; srvmon does not query registries itself. */
function sm_get_updates(): ?array
{
    $raw = @file_get_contents(SM_DOCKER_UPD);
    if ($raw === false) return null;
    $j = json_decode($raw, true);
    if (!is_array($j)) return null;
    $avail = [];
    foreach ($j as $image => $e) {
        if (!is_array($e)) continue;
        $l = (string)($e['local'] ?? '');
        $r = (string)($e['remote'] ?? '');
        if ($l !== '' && $r !== '' && $l !== 'undef' && $r !== 'undef' && $l !== $r) $avail[] = (string)$image;
    }
    sort($avail);
    return $avail;
}

function sm_os_version(): string
{
    $v = @parse_ini_file(SM_OS_VERSION) ?: [];
    return (string)($v['version'] ?? '');
}

/**
 * Reads the result of Unraid's own OS update check; srvmon does not query the release server itself.
 * null = no check has run since boot.
 */
function sm_get_os_update(): ?array
{
    if (!is_file(SM_OS_CHECK)) return null;
    $j = json_decode((string)@file_get_contents(SM_OS_CHECK), true);
    if (!is_array($j)) return null;
    $cur = sm_os_version();
    $ver = (string)($j['version'] ?? '');
    $ign = json_decode((string)@file_get_contents(SM_OS_IGNORED), true);
    $ign = is_array($ign['updateOsIgnoredReleases'] ?? null) ? $ign['updateOsIgnoredReleases'] : [];
    // isNewer refers to the version at check time; compare again in case an update was installed meanwhile
    $newer = !empty($j['isNewer']) && $ver !== '' && ($cur === '' || version_compare($ver, $cur, '>'));
    return [
        'current' => $cur,
        'version' => $newer ? $ver : null,
        'ignored' => $newer && in_array($ver, $ign, true),
        // false if the update period of the license has ended (field missing on older versions: assume eligible)
        'eligible'   => ($j['isEligible'] ?? true) !== false,
        'update_exp' => (string)($j['params']['update_exp'] ?? ''),
        'error'   => isset($j['error']) ? (string)$j['error'] : null,
        'checked' => (int)@filemtime(SM_OS_CHECK),
    ];
}

/** Attribute of a .plg file (entities resolved), as Unraid's plugin manager reads it. */
function sm_plg_attr(string $file, string $attr): string
{
    $xml = @simplexml_load_file($file, null, LIBXML_NOCDATA);
    return $xml === false ? '' : (string)($xml->attributes()[$attr] ?? '');
}

/** Installed plugins with version, without the OS itself. null = plugin directory not readable. */
function sm_get_plugins(): ?array
{
    if (!is_dir(SM_PLG_LOCAL)) return null;
    $r = [];
    foreach (glob(SM_PLG_LOCAL . '/*.plg') ?: [] as $f) {
        $name = basename($f, '.plg');
        if (in_array($name, ['unRAIDServer', 'unRAIDServer-'], true)) continue;
        $v = sm_plg_attr($f, 'version');
        if ($v !== '') $r[$name] = $v;
    }
    ksort($r, SORT_NATURAL | SORT_FLAG_CASE);
    return $r;
}

/**
 * Compares the .plg files downloaded by Unraid's plugin check with the installed ones.
 * Same rules as Unraid: string comparison of the version, min/max OS version must fit.
 * null = no plugin check has run since boot.
 */
function sm_get_plugin_updates(): ?array
{
    $files = glob(SM_PLG_NEW . '/*.plg') ?: [];
    if (!$files) return null;
    $os  = sm_os_version();
    $r   = [];
    $chk = 0;
    foreach ($files as $f) {
        $name = basename($f, '.plg');
        if (in_array($name, ['unRAIDServer', 'unRAIDServer-'], true)) continue;   // OS, see sm_get_os_update
        $chk = max($chk, (int)@filemtime($f));
        $installed = SM_PLG_LOCAL . "/$name.plg";
        if (!is_file($installed)) continue;              // downloaded but not installed
        $new = sm_plg_attr($f, 'version');
        $old = sm_plg_attr($installed, 'version');
        if ($new === '' || $old === '' || strcmp($new, $old) <= 0) continue;
        $min = sm_plg_attr($f, 'min');
        $max = sm_plg_attr($f, 'max');
        if ($os !== '' && (($min !== '' && version_compare($min, $os, '>')) || ($max !== '' && version_compare($max, $os, '<')))) continue;
        $r[$name] = ['installed' => $old, 'available' => $new];
    }
    ksort($r, SORT_NATURAL | SORT_FLAG_CASE);
    return ['updates' => $r, 'checked' => $chk ?: null];
}

// ------------------------------------------------------------ External checks (UptimeRobot)

const SM_UR_API = 'https://api.uptimerobot.com/v3';
const SM_UR_TAG = 'srvmon';   // marks monitors created by srvmon; only these are deleted

/**
 * Call the UptimeRobot API. Returns [http_code, decoded JSON or null, curl error].
 * The key is passed via a header file (mode 0600), not on the command line, so it does not show up in the process list.
 */
function sm_ur(string $key, string $method, string $path, ?array $body = null): array
{
    @mkdir(SM_TMP, 0755, true);
    $hdr = tempnam(SM_TMP, 'ur');
    @chmod($hdr, 0600);
    file_put_contents($hdr, "Authorization: Bearer $key\nContent-Type: application/json\nAccept: application/json\n");
    $url = strncmp($path, 'http', 4) === 0 ? $path : SM_UR_API . $path;
    $cmd = 'curl -sS -m 30 -X ' . escapeshellarg($method) . ' -H @' . escapeshellarg($hdr)
         . ($body !== null ? ' --data-binary ' . escapeshellarg((string)json_encode($body, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE)) : '')
         . " -w '\\n%{http_code}' " . escapeshellarg($url) . ' 2>&1';
    $out = []; $rc = 0;
    exec($cmd, $out, $rc);
    @unlink($hdr);
    $code = (int)array_pop($out);
    $txt  = implode("\n", $out);
    if ($rc !== 0) return [0, null, trim($txt) ?: "curl exit code $rc"];
    $j = json_decode($txt, true);
    return [$code, is_array($j) ? $j : null, ''];
}

/** All monitors of the account (follows the pagination). null + error text if the API is not usable. */
function sm_ur_monitors(string $key, ?string &$err, ?int &$code): ?array
{
    $all = []; $next = '/monitors?limit=200';
    for ($page = 0; $next !== '' && $page < 10; $page++) {
        [$code, $j, $cerr] = sm_ur($key, 'GET', $next);
        if ($code !== 200 || !is_array($j['data'] ?? null)) {
            $err = $cerr !== '' ? $cerr : ("HTTP $code" . (isset($j['message']) ? ': ' . $j['message'] : ''));
            return null;
        }
        $all  = array_merge($all, $j['data']);
        $next = (string)($j['nextLink'] ?? '');
    }
    return $all;
}

/**
 * Parse an entry of EXT_MONITORS: "[nextcloud:|immich:|http:]https://host[:port][/path][@LAN-address[:port]]".
 * Presets know the status path and the keyword of the application. null = invalid entry.
 */
function sm_parse_ext(string $e): ?array
{
    $e = trim($e); $type = 'http';
    if (preg_match('/^(nextcloud|immich|http):(?=https?:)/i', $e, $m)) { $type = strtolower($m[1]); $e = substr($e, strlen($m[0])); }
    $local = '';
    $at = strrpos($e, '@');
    if ($at !== false) { $local = substr($e, $at + 1); $e = substr($e, 0, $at); }
    if ($local !== '' && !preg_match('/^[\w.\-]+(:\d{1,5})?$/', $local)) return null;
    $u = parse_url($e);
    if (!is_array($u) || !in_array(strtolower($u['scheme'] ?? ''), ['http', 'https'], true) || empty($u['host']) || isset($u['user'])) return null;
    $scheme = strtolower($u['scheme']);
    $path   = $u['path'] ?? '';
    $preset = ['nextcloud' => ['/status.php', '"maintenance":false', 'Nextcloud'],
               'immich'    => ['/api/server/ping', 'pong', 'Immich']][$type] ?? null;
    if ($preset !== null && ($path === '' || $path === '/')) $path = $preset[0];
    $path .= isset($u['query']) ? '?' . $u['query'] : '';
    $url  = $scheme . '://' . $u['host'] . (isset($u['port']) ? ':' . $u['port'] : '') . ($path !== '' ? $path : '/');
    $kw   = $preset[1] ?? '';
    return [
        'type' => $type, 'url' => $url, 'scheme' => $scheme, 'host' => $u['host'],
        'port' => (int)($u['port'] ?? ($scheme === 'https' ? 443 : 80)), 'path' => $path !== '' ? $path : '/',
        'keyword' => $kw, 'name' => $preset[2] ?? $u['host'], 'local' => $local,
        'def' => ($kw !== '' ? 'KEYWORD' : 'HTTP') . '|' . sm_ext_norm($url) . '|' . $kw,
    ];
}

/** Comparable form of a URL (UptimeRobot may normalise case or a trailing slash). */
function sm_ext_norm(string $url): string
{
    return rtrim(strtolower($url), '/');
}

/** Definition key of an existing monitor, comparable with sm_parse_ext()['def']. */
function sm_ext_def(array $m): string
{
    return strtoupper((string)($m['type'] ?? '')) . '|' . sm_ext_norm((string)($m['url'] ?? '')) . '|' . (string)($m['keywordValue'] ?? '');
}

/**
 * Check the service locally via Nginx Proxy Manager (LAN address instead of the public one, with SNI).
 * Returns [ok, short result text].
 */
function sm_ext_local(array $e): array
{
    [$addr, $port] = array_pad(explode(':', $e['local'], 2), 2, '');
    $port = $port !== '' ? (int)$port : $e['port'];
    $url  = $e['scheme'] . '://' . $e['host'] . ':' . $port . $e['path'];
    $body = tempnam(SM_TMP, 'ext');
    $out  = []; $rc = 0;
    exec('timeout 20 curl -sk -m 15 -o ' . escapeshellarg($body)
         . ' --resolve ' . escapeshellarg($e['host'] . ':' . $port . ':' . $addr)
         . " -w '%{http_code}' " . escapeshellarg($url) . ' 2>/dev/null', $out, $rc);
    $code = (int)($out[0] ?? 0);
    $txt  = (string)@file_get_contents($body, false, null, 0, 65536);
    @unlink($body);
    $via  = "$addr:$port";
    if ($code === 0) return [false, "no connection to $via"];
    if ($code >= 400) return [false, "HTTP $code via $via"];
    if ($e['keyword'] !== '' && strpos($txt, $e['keyword']) === false) return [false, "HTTP $code via $via, but the expected content is missing"];
    return [true, "HTTP $code via $via"];
}

// ------------------------------------------------------------ TLS certificates

/** Parse the output of "openssl x509 -noout -enddate -subject -issuer -ext subjectAltName". */
function sm_parse_x509(array $out): ?array
{
    $end = null; $subj = ''; $iss = ''; $names = [];
    foreach ($out as $l) {
        $l = trim($l);
        if (strncmp($l, 'notAfter=', 9) === 0)    $end  = strtotime(substr($l, 9)) ?: null;
        elseif (strncmp($l, 'subject=', 8) === 0) $subj = substr($l, 8);
        elseif (strncmp($l, 'issuer=', 7) === 0)  $iss  = substr($l, 7);
        if (preg_match_all('/DNS:([^,\s]+)/', $l, $m)) $names = array_merge($names, $m[1]);
    }
    if ($end === null) return null;
    $cn  = preg_match('/CN\s*=\s*([^,\/]+)/', $subj, $m) ? trim($m[1]) : '';
    $isn = preg_match('/CN\s*=\s*([^,\/]+)/', $iss, $m) ? trim($m[1])
         : (preg_match('/O\s*=\s*([^,\/]+)/', $iss, $m) ? trim($m[1]) : '');
    $names = array_values(array_unique($names ?: ($cn !== '' ? [$cn] : [])));
    return ['expires' => $end, 'names' => $names, 'issuer' => $isn];
}

function sm_cert_from_file(string $file): ?array
{
    $out = []; $rc = 0;
    exec('timeout 15 openssl x509 -noout -enddate -subject -issuer -ext subjectAltName -in '
         . escapeshellarg($file) . ' 2>/dev/null', $out, $rc);
    return $rc === 0 ? sm_parse_x509($out) : null;
}

/** Looks in every directory for <dir>/*\/fullchain.pem (Let's Encrypt "live" layout). */
function sm_get_cert_files(array $dirs): array
{
    $res = ['missing' => [], 'certs' => []];
    foreach ($dirs as $dir) {
        $dir = rtrim($dir, '/');
        if (!is_dir($dir)) { $res['missing'][] = $dir; continue; }
        $files = glob("$dir/*/fullchain.pem") ?: [];
        if (is_file("$dir/fullchain.pem")) $files[] = "$dir/fullchain.pem";
        foreach ($files as $f) {
            $id = basename(dirname($f));
            $c  = sm_cert_from_file($f);
            $res['certs'][] = $c === null
                ? ['id' => $id, 'path' => $f, 'error' => 'Certificate not readable']
                : $c + ['id' => $id, 'path' => $f];
        }
    }
    return $res;
}

/**
 * Parse an entry. Allowed: "host", "host:port", "host@address", "host@address:port"
 * and "host:port@address". Without an address the hostname is used, without a port 443.
 */
function sm_parse_cert_host(string $e): array
{
    [$hp, $addr] = array_pad(explode('@', trim($e), 2), 2, '');
    $host = $hp; $port = 443;
    if (preg_match('/^(.+):(\d+)$/', $hp, $m)) { $host = $m[1]; $port = (int)$m[2]; }
    if (preg_match('/^(.+):(\d+)$/', $addr, $m)) { $addr = $m[1]; $port = (int)$m[2]; }
    return ['host' => $host, 'port' => $port, 'addr' => $addr !== '' ? $addr : $host];
}

/** Fetch and check the served certificate via TLS handshake (with SNI). */
function sm_get_cert_live(string $entry): array
{
    $t   = sm_parse_cert_host($entry);
    $res = $t + ['error' => null, 'verify' => null];
    $out = []; $rc = 0;
    exec('timeout 15 openssl s_client -connect ' . escapeshellarg($t['addr'] . ':' . $t['port'])
         . ' -servername ' . escapeshellarg($t['host'])
         . ' -verify_hostname ' . escapeshellarg($t['host'])
         . ' </dev/null 2>/dev/null', $out, $rc);
    $txt = implode("\n", $out);
    if (!preg_match('/-----BEGIN CERTIFICATE-----.+?-----END CERTIFICATE-----/s', $txt, $m)) {
        $res['error'] = 'No TLS connection to ' . $t['addr'] . ':' . $t['port'];
        return $res;
    }
    if (preg_match('/Verify return code: (\d+) \(([^)]*)\)/', $txt, $v)) {
        $res['verify'] = ['code' => (int)$v[1], 'text' => $v[2]];
    }
    @mkdir(SM_TMP, 0755, true);
    $tmp = tempnam(SM_TMP, 'cert');
    file_put_contents($tmp, $m[0]);
    $c = sm_cert_from_file($tmp);
    @unlink($tmp);
    if ($c === null) { $res['error'] = 'Certificate could not be parsed'; return $res; }
    return $res + $c;
}

/** Does the certificate cover the hostname? Wildcards match exactly one label. */
function sm_cert_covers(array $names, string $host): bool
{
    $host = strtolower($host);
    foreach ($names as $n) {
        $n = strtolower($n);
        if ($n === $host) return true;
        if (strncmp($n, '*.', 2) === 0) {
            $dot = strpos($host, '.');
            if ($dot !== false && substr($host, $dot + 1) === substr($n, 2)) return true;
        }
    }
    return false;
}
]]></INLINE>
</FILE>

