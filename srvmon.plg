<INLINE><![CDATA[<?php
/*
 * srvmon - translations for notifications (Unraid and webhook).
 *
 * Checks produce English texts. sm_tr() matches such a text against the English templates below
 * and returns the translation with the values filled in. Placeholders: {name} is copied as is,
 * {@name} is translated recursively (for nested texts such as "Still active: <subject>").
 * Texts without a matching template stay English. When changing a text in check.php,
 * change its template here as well.
 */
declare(strict_types=1);

const SM_LANGS = ['en' => 'English', 'de' => 'Deutsch', 'fr' => 'Français', 'es' => 'Español'];

