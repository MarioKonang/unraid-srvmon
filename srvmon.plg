<FILE Name="&emhttp;/SrvmonStatus.page">
<INLINE><![CDATA[Menu="Utilities"
Title="Server Monitor Status"
Icon="heartbeat"
Markdown="false"
---
<style>
.smd{--ok:#3b8c2a;--warn:#c98a00;--crit:#c0392b;--line:rgba(127,127,127,.25);--soft:rgba(127,127,127,.10);max-width:1400px}
.smd-head{display:flex;flex-wrap:wrap;gap:.5em 1.5em;align-items:center;margin:0 0 1em}
.smd-badge{display:inline-block;padding:.15em .6em;border-radius:4px;font-weight:bold;color:#fff}
.smd-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:1em}
.smd-card{border:1px solid var(--line);border-radius:6px;padding:.8em 1em;min-width:0}
.smd-card h3{margin:0 0 .6em;font-size:1.05em}
.smd-wide{grid-column:1/-1}
.smd-row{display:flex;justify-content:space-between;gap:1em;margin:.25em 0}
.smd-bar{height:8px;background:var(--soft);border-radius:4px;overflow:hidden;margin:.2em 0 .6em}
.smd-bar>span{display:block;height:100%}
.smd-scroll{overflow-x:auto}
.smd table{width:100%;border-collapse:collapse}
.smd th,.smd td{text-align:left;padding:.3em .5em;border-bottom:1px solid var(--line);white-space:nowrap}
.smd-chip{display:inline-block;padding:.05em .5em;border-radius:3px;font-size:.9em;border:1px solid currentColor}
.smd-issue{border-left:4px solid;padding:.3em .7em;margin:.4em 0;background:var(--soft)}
.smd-muted{opacity:.7;font-size:.9em}
.smd-ok{color:var(--ok)}.smd-warn{color:var(--warn)}.smd-crit{color:var(--crit)}
</style>
<div class="smd" id="smd">
<div class="smd-head"><span id="smd-summary">Lade Daten …</span><span class="smd-muted" id="smd-times"></span><span class="smd-muted">Aktualisierung alle 30 s</span></div>
<div class="smd-grid" id="smd-grid"></div>
</div>
<script>
(function(){
  var URL='/plugins/srvmon/include/data.php', REFRESH=30000;
  function esc(s){return String(s==null?'':s).replace(/[&<>"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];});}
  function fmtB(b){if(b==null)return '–';var u=['B','KB','MB','GB','TB','PB'],i=0;b=Number(b);while(b>=1024&&i<u.length-1){b/=1024;i++;}return b.toFixed(1).replace('.',',')+' '+u[i];}
  function fmtT(ts){if(!ts)return '–';var d=new Date(ts*1000);return d.toLocaleString('de-DE');}
  function fmtUp(s){var d=Math.floor(s/86400),h=Math.floor(s%86400/3600),m=Math.floor(s%3600/60);return (d?d+' T ':'')+h+' h '+m+' min';}
  function lvlCls(v,w,c){if(v==null)return '';return v>=c?'smd-crit':(v>=w?'smd-warn':'smd-ok');}
  function col(cls){return cls==='smd-crit'?'var(--crit)':(cls==='smd-warn'?'var(--warn)':'var(--ok)');}
  function bar(pct,cls){var p=Math.max(0,Math.min(100,pct||0));return '<div class="smd-bar"><span style="width:'+p+'%;background:'+col(cls)+'"></span></div>';}
  function card(title,body,wide){return '<div class="smd-card'+(wide?' smd-wide':'')+'"><h3>'+esc(title)+'</h3>'+body+'</div>';}
  function chip(text,cls){return '<span class="smd-chip '+cls+'">'+esc(text)+'</span>';}
  function n1(v){return v==null?'–':Number(v).toFixed(1).replace('.',',');}
  function render(d){
    var t=d.thresholds, h='';
    var crit=d.issues.filter(function(i){return i.level==='alert';}).length, warn=d.issues.length-crit;
    var sum=crit?'<span class="smd-badge" style="background:var(--crit)">'+crit+' kritisch</span> ':'';
    sum+=warn?'<span class="smd-badge" style="background:var(--warn)">'+warn+' Warnung'+(warn>1?'en':'')+'</span>':'';
    if(!crit&&!warn)sum='<span class="smd-badge" style="background:var(--ok)">Alles in Ordnung</span>';
    document.getElementById('smd-summary').innerHTML=sum;
    document.getElementById('smd-times').textContent='Live-Daten: '+fmtT(d.time)+' · Letzte Prüfung: '+fmtT(d.lastrun);
    if(d.issues.length){
      var b='';d.issues.forEach(function(i){var c=i.level==='alert'?'smd-crit':'smd-warn';
        b+='<div class="smd-issue" style="border-color:'+col(c)+'"><b class="'+c+'">'+esc(i.subject)+'</b><br>'+esc(i.desc)+'<br><span class="smd-muted">seit '+fmtT(i.since)+'</span></div>';});
      h+=card('Aktive Probleme',b,true);
    }
    if(d.system){
      var s=d.system,b='',lc=lvlCls(s.load_pct,t.cpu,1e9),mc=lvlCls(s.mem_pct,t.ram,1e9);
      b+='<div class="smd-row"><span>CPU-Last (5 min)</span><span class="'+lc+'">'+n1(s.load_pct)+' %</span></div>'+bar(s.load_pct,lc);
      b+='<div class="smd-row smd-muted"><span>Load 1 / 5 / 15</span><span>'+s.load.map(function(x){return x==null?'–':x.toFixed(2);}).join(' / ')+' ('+s.cores+' CPUs)</span></div>';
      b+='<div class="smd-row"><span>RAM</span><span class="'+mc+'">'+n1(s.mem_pct)+' %</span></div>'+bar(s.mem_pct,mc);
      b+='<div class="smd-row smd-muted"><span>Verfügbar / Gesamt</span><span>'+fmtB(s.mem_avail)+' / '+fmtB(s.mem_total)+'</span></div>';
      b+='<div class="smd-row"><span>Uptime</span><span>'+fmtUp(s.uptime)+'</span></div>';
      h+=card('System',b);
    }
    if('ups' in d){
      var b='';
      if(!d.ups)b='<span class="smd-muted">Keine USV-Daten (apcupsd nicht aktiv).</span>';
      else{var u=d.ups,uc=/ONBATT|COMMLOST|REPLACEBATT|LOWBATT/i.test(u.status)?'smd-crit':'smd-ok';
        b+='<div class="smd-row"><span>Status</span><span>'+chip(u.status||'?',uc)+'</span></div>';
        b+='<div class="smd-row"><span>Ladung</span><span>'+esc(u.charge||'–')+'</span></div>';
        b+='<div class="smd-row"><span>Restlaufzeit</span><span>'+esc(u.timeleft||'–')+'</span></div>';
        b+='<div class="smd-row"><span>Last</span><span>'+esc(u.load||'–')+'</span></div>';
        if(u.model)b+='<div class="smd-row smd-muted"><span>Modell</span><span>'+esc(u.model)+'</span></div>';}
      h+=card('USV',b);
    }
    if(d.space){
      var b='';
      if(!d.space.length)b='<span class="smd-muted">Keiner der konfigurierten Pfade ist gemountet.</span>';
      d.space.forEach(function(p){var c=lvlCls(p.pct,t.space[0],t.space[1]);
        b+='<div class="smd-row"><span>'+esc(p.path)+'</span><span class="'+c+'">'+n1(p.pct)+' %</span></div>'+bar(p.pct,c);
        b+='<div class="smd-row smd-muted" style="margin-top:-.5em"><span></span><span>frei '+fmtB(p.free)+' von '+fmtB(p.total)+'</span></div>';});
      h+=card('Speicherplatz',b);
    }
    if('disks' in d){
      var b;
      if(!d.disks)b='<span class="smd-muted">disks.ini nicht lesbar.</span>';
      else{
        b='<div class="smd-scroll"><table><thead><tr><th>Disk</th><th>Gerät</th><th>Status</th><th>Temp.</th><th>Fehler</th><th>SMART (letzter Stand)</th></tr></thead><tbody>';
        d.disks.forEach(function(k){
          var th=k.nvme?t.nvme:t.hdd, tc=k.type==='Flash'?'':lvlCls(k.temp,th[0],th[1]);
          var temp=k.temp==null?'<span class="smd-muted">'+(k.type==='Flash'?'–':'Standby')+'</span>':'<span class="'+tc+'">'+k.temp+' °C</span>';
          var sm='<span class="smd-muted">–</span>';
          if(k.smart){var parts=[],bad=false;
            Object.keys(k.smart.counters||{}).forEach(function(l){var v=k.smart.counters[l];if(v>0){parts.push(l.replace(/_/g,' ')+': '+v);bad=true;}});
            if(k.smart.passed===false){parts.unshift('FAILED');bad=true;}
            if(k.smart.wear!=null)parts.push('Verschleiß '+k.smart.wear+' %');
            sm=bad?'<span class="smd-crit">'+esc(parts.join(', '))+'</span>':'<span class="smd-ok">OK</span>'+(parts.length?' <span class="smd-muted">'+esc(parts.join(', '))+'</span>':'');}
          b+='<tr><td>'+esc(k.name)+'</td><td>'+esc(k.device)+'</td><td>'+(k.status==='DISK_OK'?chip('OK','smd-ok'):chip(k.status,'smd-crit'))+'</td><td>'+temp+'</td><td class="'+(k.errors>0?'smd-crit':'')+'">'+k.errors+'</td><td>'+sm+'</td></tr>';});
        b+='</tbody></table></div>';
      }
      h+=card('Disks',b,true);
    }
    if('docker' in d){
      var b;
      if(!d.docker)b='<span class="smd-muted">Docker-Dienst nicht erreichbar.</span>';
      else{var all=d.docker_watch.indexOf('*')>=0,run=d.docker.filter(function(c){return c.state==='running';}).length,upd=d.docker.filter(function(c){return c.update_available;}).length;
        b='<div class="smd-row smd-muted"><span>'+run+' von '+d.docker.length+' laufen'+(upd?' · <span class="smd-warn">'+upd+' Update(s)</span>':'')+'</span><span>'+(all?'Alle überwacht':'Überwacht: '+esc(d.docker_watch.join(', ')||'keine'))+'</span></div>';
        b+='<div class="smd-scroll"><table><tbody>';
        d.docker.forEach(function(c){var w=all||d.docker_watch.indexOf(c.name)>=0,ok=c.state==='running';
          var cls=c.unhealthy?'smd-warn':(ok?'smd-ok':(w?'smd-crit':''));
          var info=(c.version?'v '+esc(c.version):'')+(c.updated?(c.version?' · ':'')+'aktualisiert '+fmtT(c.updated):'');
          b+='<tr><td>'+esc(c.name)+(w&&!all?' <span class="smd-muted">(überwacht)</span>':'')+'</td><td>'+chip(c.unhealthy?'unhealthy':c.state,cls)+(c.update_available?' '+chip('Update','smd-warn'):'')+'</td><td class="smd-muted">'+esc(c.status)+(info?'<br>'+info:'')+'</td></tr>';});
        b+='</tbody></table></div>';}
      h+=card('Docker',b);
    }
    if('vms' in d){
      var b;
      if(!d.vms)b='<span class="smd-muted">VM-Dienst nicht erreichbar.</span>';
      else if(!d.vms.length)b='<span class="smd-muted">Keine VMs angelegt.</span>';
      else{var all=d.vm_watch.indexOf('*')>=0;b='<table><tbody>';
        d.vms.forEach(function(v){var w=all||d.vm_watch.indexOf(v.name)>=0,ok=v.state==='running';
          var cls=v.state==='crashed'?'smd-crit':(ok?'smd-ok':(w?'smd-crit':''));
          b+='<tr><td>'+esc(v.name)+(w&&!all?' <span class="smd-muted">(überwacht)</span>':'')+'</td><td>'+chip(v.state||'?',cls)+'</td></tr>';});
        b+='</tbody></table>';}
      h+=card('VMs',b);
    }
    if('updates' in d){
      var b;
      if(!d.updates)b='<span class="smd-muted">Keine Update-Informationen von Unraid vorhanden.</span>';
      else if(!d.updates.length)b='<span class="smd-ok">Alle Images aktuell.</span>';
      else{b='<div class="smd-row"><span class="smd-warn">'+d.updates.length+' Update(s) verfügbar</span></div><ul style="margin:.3em 0 0 1.2em;padding:0">';
        d.updates.forEach(function(u){b+='<li>'+esc(u)+'</li>';});b+='</ul>';}
      h+=card('Docker-Updates',b);
    }
    if('certs' in d){
      var b;
      if(!d.certs)b='<span class="smd-muted">Noch keine Zertifikatsprüfung gelaufen.</span>';
      else if(!d.certs.items.length)b='<span class="smd-muted">Keine Zertifikate gefunden. Verzeichnisse und Hosts in den Einstellungen prüfen.</span>';
      else{var ct=t.cert||[20,7];b='<div class="smd-scroll"><table><thead><tr><th>Name</th><th>Quelle</th><th>Gültig bis</th><th>Rest</th><th>Hinweis</th></tr></thead><tbody>';
        d.certs.items.forEach(function(c){
          var cls=(c.days==null||c.superseded)?'smd-muted':(c.days<=ct[1]?'smd-crit':(c.days<=ct[0]?'smd-warn':'smd-ok'));
          var note=c.error?'<span class="smd-crit">'+esc(c.error)+'</span>':[c.verify?'<span class="smd-warn">'+esc(c.verify)+'</span>':'',c.stale?'<span class="smd-warn">älter als Datei</span>':'',c.superseded?'<span class="smd-muted">ersetzt durch '+esc(c.superseded)+', wird ignoriert</span>':'',c.issuer?'<span class="smd-muted">'+esc(c.issuer)+'</span>':''].filter(Boolean).join(' · ');
          b+='<tr><td>'+esc(c.name)+(c.names&&c.names.length>1?' <span class="smd-muted">+'+(c.names.length-1)+'</span>':'')+'</td><td>'+esc(c.source)+'</td><td>'+(c.expires?new Date(c.expires*1000).toLocaleDateString('de-DE'):'–')+'</td><td class="'+cls+'">'+(c.days==null?'–':c.days+' T')+'</td><td>'+note+'</td></tr>';});
        b+='</tbody></table></div><div class="smd-muted" style="margin-top:.4em">Geprüft: '+fmtT(d.certs.time)+'</div>';}
      h+=card('TLS-Zertifikate',b,true);
    }
    document.getElementById('smd-grid').innerHTML=h;
  }
  function load(){
    fetch(URL,{cache:'no-store',credentials:'same-origin'})
      .then(function(r){if(!r.ok)throw new Error('HTTP '+r.status);return r.json();})
      .then(render)
      .catch(function(e){document.getElementById('smd-summary').innerHTML='<span class="smd-crit">Daten konnten nicht geladen werden ('+esc(e.message)+').</span>';});
  }
  load();
  setInterval(function(){if(!document.hidden)load();},REFRESH);
})();
</script>
]]></INLINE>
</FILE>

<FILE Run="/bin/bash">
<INLINE>
mkdir -p &plgpath;
chmod 0755 &emhttp;/scripts/check.php
# Cron: jede Minute aufrufen, das Intervall prueft das Skript selbst
cat > &plgpath;/&name;.cron &lt;&lt;'EOF'
# srvmon
* * * * * /usr/bin/php &emhttp;/scripts/check.php &gt;/dev/null 2&gt;&amp;1
EOF
/usr/local/sbin/update_cron
# update_cron beruecksichtigt nur bereits registrierte Plugins. Waehrend dieses Skripts ist srvmon
# noch nicht registriert, daher nach Abschluss der Installation erneut einlesen.
nohup bash -c 'sleep 15; /usr/local/sbin/update_cron' &gt;/dev/null 2&gt;&amp;1 &amp;
echo "srvmon &version; installiert. Seiten: Settings > User Utilities > Server Monitor / Server Monitor Status"
</INLINE>
</FILE>

<FILE Run="/bin/bash" Method="remove">
<INLINE>
rm -f &plgpath;/&name;.cron
/usr/local/sbin/update_cron
rm -rf &emhttp; /tmp/&name;
echo "srvmon entfernt. Konfiguration und Zustand bleiben in &plgpath; erhalten."
</INLINE>
</FILE>

</PLUGIN>
