/** Valid language code from the configuration, otherwise English. */
function sm_lang(array $cfg, string $key): string
{
    $l = strtolower(trim((string)($cfg[$key] ?? 'en')));
    return isset(SM_LANGS[$l]) ? $l : 'en';
}

/** Translate an English notification text, see the comment at the top. */
function sm_tr(string $text, string $lang, int $depth = 0): string
{
    if ($lang === 'en' || !isset(SM_LANGS[$lang]) || $depth > 3) return $text;
    static $rx = null;
    if ($rx === null) {
        // compile the templates to anchored regular expressions, most specific (most literal text) first
        $rx = [];
        foreach (SM_TEXTS as $tpl => $tr) {
            $parts = preg_split('/\{(@?\w+)\}/', $tpl, -1, PREG_SPLIT_DELIM_CAPTURE);
            $re = ''; $names = []; $lit = 0;
            foreach ($parts as $i => $p) {
                if ($i % 2) { $re .= '(.+?)'; $names[] = $p; }
                else        { $re .= preg_quote($p, '/'); $lit += strlen($p); }
            }
            $rx[] = ['/^' . $re . '$/su', $tpl, $names, $lit];
        }
        usort($rx, fn($a, $b) => $b[3] <=> $a[3]);
    }
    foreach ($rx as [$re, $tpl, $names]) {
        if (!isset(SM_TEXTS[$tpl][$lang]) || !preg_match($re, $text, $m)) continue;
        $rep = [];
        foreach ($names as $i => $n) {
            $v = $m[$i + 1];
            $rep['{' . $n . '}'] = $n[0] === '@' ? sm_tr($v, $lang, $depth + 1) : $v;
        }
        return strtr(SM_TEXTS[$tpl][$lang], $rep);
    }
    return $text;
}
]]></INLINE>
</FILE>

<FILE Name="&emhttp;/include/data.php">
<INLINE><![CDATA[<?php
/*
 * srvmon - JSON endpoint for the status page.
 * Located under /plugins/srvmon/include/ and therefore protected by the WebGUI login.
 * SMART is NOT read live here (too slow); the last state from check.php is shown instead.
 */
declare(strict_types=1);
require_once '/usr/local/emhttp/plugins/srvmon/include/lib.php';

header('Content-Type: application/json; charset=utf-8');
header('Cache-Control: no-store');

$cfg    = sm_load_cfg();
$state  = sm_load_state();
$status = json_decode((string)@file_get_contents(SM_TMP . '/status.json'), true) ?: [];

$issues = [];
foreach ($state['issues'] ?? [] as $k => $i) {
    $issues[] = ['key' => (string)$k, 'level' => $i['level'] ?? 'warning', 'subject' => $i['subject'] ?? '',
                 'desc' => $i['desc'] ?? '', 'since' => (int)($i['since'] ?? 0)];
}
usort($issues, fn($a, $b) => (['alert' => 0, 'warning' => 1][$a['level']] ?? 2)
                            <=> (['alert' => 0, 'warning' => 1][$b['level']] ?? 2));

$out = [
    'time'    => time(),
    'lastrun' => isset($status['lastrun']) ? (int)$status['lastrun'] : null,
    'issues'  => $issues,
    'thresholds' => [
        'hdd'   => [sm_num($cfg, 'TEMP_HDD_WARN', 45),  sm_num($cfg, 'TEMP_HDD_CRIT', 50)],
        'nvme'  => [sm_num($cfg, 'TEMP_NVME_WARN', 60), sm_num($cfg, 'TEMP_NVME_CRIT', 70)],
        'space' => [sm_num($cfg, 'SPACE_WARN', 85),     sm_num($cfg, 'SPACE_CRIT', 95)],
        'cpu'   => sm_num($cfg, 'CPU_LOAD_WARN', 90),
        'ram'   => sm_num($cfg, 'RAM_WARN', 90),
    ],
];

if (sm_on($cfg, 'CHECK_SYSTEM')) $out['system'] = sm_get_system();
unset($out['system']['boot_id']);

if (sm_on($cfg, 'CHECK_DISKS')) {
    $disks = sm_get_disks();
    if ($disks !== null) {
        foreach ($disks as &$d) {
            $d['smart'] = $state['smart'][$d['id']] ?? null;
            unset($d['id']);   // usually contains the serial number, not needed in the browser
        }
        unset($d);
    }
    $out['disks'] = $disks;
}
if (sm_on($cfg, 'CHECK_SPACE'))   $out['space']  = sm_get_space(sm_list($cfg['SPACE_PATHS'] ?? ''));
if (sm_on($cfg, 'CHECK_DOCKER')) {
    $out['docker']       = sm_get_docker();
    $out['docker_watch'] = sm_list($cfg['DOCKER_WATCH'] ?? '');
    if (is_array($out['docker'])) {
        $avail = array_map('sm_norm_image', sm_get_updates() ?? []);
        foreach ($out['docker'] as &$c) {
            $img = $state['docker_img'][$c['name']] ?? null;   // state of the last check
            $c['version']          = $img['version'] ?? '';
            $c['updated']          = $img['updated'] ?? null;
            $c['update_available'] = $img !== null && in_array(sm_norm_image((string)$img['image']), $avail, true);
        }
        unset($c);
    }
}
if (sm_on($cfg, 'CHECK_VMS')) {
    $out['vms']      = sm_get_vms();
    $out['vm_watch'] = sm_list($cfg['VM_WATCH'] ?? '');
}
if (sm_on($cfg, 'CHECK_UPS'))     $out['ups']     = sm_get_ups();
if (sm_on($cfg, 'CHECK_UPDATES')) $out['updates'] = sm_get_updates();
if (sm_on($cfg, 'CHECK_OS_UPDATES') || sm_on($cfg, 'CHECK_PLUGIN_UPDATES') || sm_on($cfg, 'CHECK_PLUGIN_UPDATED')) {
    $out['sysupd'] = ['os_current' => sm_os_version()];
    if (sm_on($cfg, 'CHECK_OS_UPDATES'))     $out['sysupd']['os']      = sm_get_os_update();
    if (sm_on($cfg, 'CHECK_PLUGIN_UPDATES')) $out['sysupd']['plugins'] = sm_get_plugin_updates();
    if (sm_on($cfg, 'CHECK_PLUGIN_UPDATED')) {
        // plugins updated in the last 7 days, newest first (state of the last check)
        $recent = [];
        foreach ($state['plugins'] ?? [] as $n => $p) {
            if (!empty($p['updated']) && time() - (int)$p['updated'] < 7 * 86400) {
                $recent[] = ['name' => (string)$n, 'version' => (string)$p['version'], 'updated' => (int)$p['updated']];
            }
        }
        usort($recent, fn($a, $b) => $b['updated'] <=> $a['updated']);
        $out['sysupd']['recent'] = $recent;
    }
}
if (sm_on($cfg, 'CHECK_CERTS')) {
    // result of the last check run; no TLS handshakes on every page load
    $certs = json_decode((string)@file_get_contents(SM_TMP . '/certs.json'), true);
    $out['certs'] = is_array($certs) ? $certs : null;
    $out['thresholds']['cert'] = [sm_num($cfg, 'CERT_WARN_DAYS', 20), sm_num($cfg, 'CERT_CRIT_DAYS', 7)];
}
if (sm_on($cfg, 'CHECK_EXTERNAL') && trim((string)($cfg['UPTIMEROBOT_KEY'] ?? '')) !== '') {
    // result of the last check run; the API key never goes to the browser
    $ext = json_decode((string)@file_get_contents(SM_TMP . '/ext.json'), true);
    $out['ext'] = is_array($ext) ? $ext : null;
}

echo json_encode($out, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE);
]]></INLINE>
</FILE>

<FILE Name="&emhttp;/scripts/check.php" Mode="0755">
<INLINE><![CDATA[#!/usr/bin/php
<?php
/*
 * srvmon - health monitoring for Unraid
 *
 * Usage:  check.php [--force] [--dry-run] [--test]
 *   --force    ignore the interval and check immediately
 *   --dry-run  print only; send nothing, do not save state
 *   --test     send a test notification
 *
 * Notifications are sent exclusively via Unraid's notify script. Whether an
 * email goes out is controlled by the agents under Settings > Notifications.
 */
declare(strict_types=1);
require_once '/usr/local/emhttp/plugins/srvmon/include/lib.php';
require_once '/usr/local/emhttp/plugins/srvmon/include/lang.php';

const SM_MAX_PER_RUN = 10;
const SM_MAX_HOOKS   = 3;     // webhook calls per run, so a voice assistant does not talk for minutes

$opt   = getopt('', ['force', 'dry-run', 'test']);
$force = isset($opt['force']);
$dry   = isset($opt['dry-run']);
$cfg   = sm_load_cfg();

if (isset($opt['test'])) {
    sm_send('normal', 'Test notification',
        'srvmon is active. If you receive this message, delivery is set up correctly.', true);
    exit(0);
}

@mkdir(SM_TMP, 0755, true);
$lock = fopen(SM_TMP . '/lock', 'c');
if ($lock === false || !flock($lock, LOCK_EX | LOCK_NB)) exit(0);

$runFile  = SM_TMP . '/lastrun';
$interval = max(1, (int)sm_num($cfg, 'INTERVAL', 5)) * 60;
$last     = (int)@file_get_contents($runFile);
if (!$force && time() - $last < $interval - 10) exit(0);
if (!$dry) file_put_contents($runFile, (string)time());

$state  = sm_load_state();
$issues = [];   // ongoing conditions: key => [level, subject, desc]
$events = [];   // one-off events: [level, subject, desc]
$ran    = [];   // key prefixes of checks that delivered data

if (sm_on($cfg, 'CHECK_DISKS'))   sm_check_disks($cfg, $state, $issues, $events, $ran);
if (sm_on($cfg, 'CHECK_SPACE'))   sm_check_space($cfg, $issues, $ran);
if (sm_on($cfg, 'CHECK_DOCKER'))  sm_check_docker($cfg, $state, $issues, $events, $ran);
if (sm_on($cfg, 'CHECK_DOCKER') && sm_on($cfg, 'CHECK_DOCKER_UPDATED')) sm_check_docker_updated($state, $events);
if (sm_on($cfg, 'CHECK_VMS'))     sm_check_vms($cfg, $state, $issues, $events, $ran);
if (sm_on($cfg, 'CHECK_SYSTEM'))  sm_check_system($cfg, $state, $issues, $events, $ran);
if (sm_on($cfg, 'CHECK_UPS'))     sm_check_ups($issues, $ran);
if (sm_on($cfg, 'CHECK_UPDATES')) sm_check_updates($state, $events);
if (sm_on($cfg, 'CHECK_OS_UPDATES'))     sm_check_os_update($state, $events);
if (sm_on($cfg, 'CHECK_PLUGIN_UPDATES')) sm_check_plugin_updates($state, $events);
if (sm_on($cfg, 'CHECK_PLUGIN_UPDATED')) sm_check_plugin_updated($state, $events);
if (sm_on($cfg, 'CHECK_CERTS'))   sm_check_certs($cfg, $force, $state, $issues, $ran);
if (sm_on($cfg, 'CHECK_EXTERNAL')) sm_check_external($cfg, $state, $issues, $events, $ran);

// ---------------------------------------------------------------- Evaluation
$now    = time();
$remind = (int)sm_num($cfg, 'REMIND_HOURS', 24) * 3600;
$prev   = $state['issues'] ?? [];
$next   = [];
$queue  = [];

foreach ($issues as $key => [$lvl, $subj, $desc]) {
    $p = $prev[$key] ?? null;
    if ($p === null || sm_rank($lvl) > sm_rank((string)$p['level'])) {
        $queue[] = [$lvl, $subj, $desc];
        $next[$key] = ['level' => $lvl, 'subject' => $subj, 'desc' => $desc,
                       'since' => $p['since'] ?? $now, 'notified' => $now];
    } elseif ($remind > 0 && $now - (int)$p['notified'] >= $remind) {
        $queue[] = [$lvl, "Still active: $subj",
                    $desc . ' (since ' . date('Y-m-d H:i', (int)$p['since']) . ')'];
        $next[$key] = ['level' => $lvl, 'subject' => $subj, 'desc' => $desc,
                       'since' => $p['since'], 'notified' => $now];
    } else {
        // do not update the description, otherwise the flash drive would be written on every run
        $p['level'] = $lvl;
        $next[$key] = $p;
    }
}
foreach ($prev as $key => $p) {
    if (isset($next[$key])) continue;
    if (!sm_prefix_ran((string)$key, $ran)) { $next[$key] = $p; continue; }   // check did not run: decide nothing
    if (sm_on($cfg, 'NOTIFY_RESOLVED')) {
        $queue[] = ['normal', 'Resolved: ' . $p['subject'], 'The condition is back to normal.'];
    }
}
$state['issues'] = $next;
$queue = array_merge($queue, $events);

$sent = 0;
foreach ($queue as [$lvl, $subj, $desc]) {
    if ($sent >= SM_MAX_PER_RUN) {
        sm_send('warning', 'Further notifications suppressed',
            (count($queue) - $sent) . ' more notifications in this run. Details in the syslog (tag srvmon).');
        break;
    }
    sm_send($lvl, $subj, $desc);
    $sent++;
}

sm_webhook_flush();

if (!$dry) {
    // heartbeat for external monitoring (e.g. healthchecks.io, Uptime Kuma push); in the background, non-blocking
    $hb = trim((string)($cfg['HEARTBEAT_URL'] ?? ''));
    if ($hb !== '') exec('curl -fsS -m 10 --retry 2 -o /dev/null ' . escapeshellarg($hb) . ' >/dev/null 2>&1 &');
    sm_save_state($state);
    @file_put_contents(SM_TMP . '/status.json', json_encode(
        ['lastrun' => $now, 'issues' => $next], JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE));
}
exit(0);

// ================================================================== Checks

function sm_check_disks(array $cfg, array &$state, array &$issues, array &$events, array &$ran): void
{
    $disks = sm_get_disks();
    if ($disks === null) return;
    $ran[] = 'disk:';
    $smartOn = sm_on($cfg, 'CHECK_SMART');
    if ($smartOn) $ran[] = 'smart:';

    foreach ($disks as $d) {
        ['name' => $name, 'device' => $dev, 'status' => $status] = $d;

        if ($status !== 'DISK_OK') {
            $issues["disk:$name:status"] = ['alert', "Disk $name: Status $status",
                "Disk $name (" . ($dev !== '' ? $dev : 'no device detected') . ") reports status $status."];
        }
        if ($d['errors'] > 0) {
            $issues["disk:$name:errors"] = ['alert', "Disk $name: I/O errors",
                "Unraid counts {$d['errors']} read/write errors on disk $name ($dev)."];
        }
        if ($d['type'] === 'Flash') continue;

        if ($d['temp'] !== null) {
            $t = $d['temp'];
            $w = sm_num($cfg, $d['nvme'] ? 'TEMP_NVME_WARN' : 'TEMP_HDD_WARN', $d['nvme'] ? 60 : 45);
            $c = sm_num($cfg, $d['nvme'] ? 'TEMP_NVME_CRIT' : 'TEMP_HDD_CRIT', $d['nvme'] ? 70 : 50);
            if ($t >= $c) {
                $issues["disk:$name:temp"] = ['alert', "Disk $name: temperature critical",
                    "Disk $name ($dev) is at {$t} °C (critical from {$c} °C)."];
            } elseif ($t >= $w) {
                $issues["disk:$name:temp"] = ['warning', "Disk $name: temperature high",
                    "Disk $name ($dev) is at {$t} °C (warning from {$w} °C)."];
            }
        }
        if ($smartOn && $dev !== '') sm_check_smart($d, $state, $issues, $events);
    }
}

function sm_check_smart(array $d, array &$state, array &$issues, array &$events): void
{
    ['name' => $name, 'device' => $dev, 'id' => $id] = $d;
    $s = sm_get_smart($dev);
    if ($s === null) {                       // standby or unreadable: keep the previous state
        sm_keep($state, $issues, "smart:$name:");
        return;
    }
    if (!$s['passed']) {
        $issues["smart:$name:health"] = ['alert', "Disk $name: SMART status FAILED",
            "The overall SMART status of disk $name ($dev) is FAILED. Replace the disk soon."];
    }
    if ($s['nvme_cw']) {
        $issues["smart:$name:nvme_cw"] = ['alert', "Disk $name: NVMe Critical Warning",
            sprintf('Disk %s (%s) reports critical_warning = 0x%02x.', $name, $dev, $s['nvme_cw'])];
    }
    if ($s['wear'] !== null && $s['wear'] >= 90) {
        $issues["smart:$name:wear"] = ['warning', "Disk $name: wear {$s['wear']} %",
            "According to SMART, disk $name ($dev) has used {$s['wear']} % of its rated lifetime."];
    }

    $base = $state['smart'][$id]['counters'] ?? [];
    $save = [];
    foreach ($s['counters'] as $label => [$val, $lvl]) {
        $old = (int)($base[$label] ?? 0);    // without a baseline, a value > 0 is reported once
        if ($val > $old) {
            $events[] = [$lvl, "Disk $name: $label increased",
                "Disk $name ($dev): $label increased from $old to $val."];
        }
        $save[$label] = $val;
    }
    // also shown on the status page (last known state)
    $state['smart'][$id] = ['passed' => $s['passed'], 'wear' => $s['wear'], 'counters' => $save];
}

function sm_check_space(array $cfg, array &$issues, array &$ran): void
{
    $ran[] = 'space:';
    $w = sm_num($cfg, 'SPACE_WARN', 85);
    $c = sm_num($cfg, 'SPACE_CRIT', 95);
    foreach (sm_get_space(sm_list($cfg['SPACE_PATHS'] ?? '')) as $s) {
        $p   = $s['path'];
        $txt = sprintf('%s is %.1f %% full (free: %s).', $p, $s['pct'], sm_bytes((float)$s['free']));
        if ($s['pct'] >= $c)     $issues["space:$p"] = ['alert',   "Storage almost full: $p", $txt];
        elseif ($s['pct'] >= $w) $issues["space:$p"] = ['warning', "Storage running low: $p", $txt];
    }
}

function sm_check_docker(array $cfg, array &$state, array &$issues, array &$events, array &$ran): void
{
    $list = sm_get_docker();
    if ($list === null) return;
    $ran[] = 'docker:';

    $watch = sm_list($cfg['DOCKER_WATCH'] ?? '');
    $all   = in_array('*', $watch, true);
    $prev  = $state['docker'] ?? [];
    $now   = [];

    foreach ($list as ['name' => $n, 'state' => $st, 'status' => $status, 'unhealthy' => $bad]) {
        $now[$n] = $st;
        if ($bad) {
            $issues["docker:$n:health"] = ['warning', "Container $n: unhealthy",
                "The health check of container $n is failing ($status)."];
        }
        if (!$all && in_array($n, $watch, true) && $st !== 'running') {
            $issues["docker:$n:down"] = ['alert', "Container $n is not running",
                "Watched container $n is in state '$st' ($status)."];
        }
        if ($all && ($prev[$n] ?? '') === 'running' && $st !== 'running') {
            $events[] = ['warning', "Container $n stopped", "Container $n: $status"];
        }
    }
    foreach ($watch as $n) {
        if ($n !== '*' && !isset($now[$n])) {
            $issues["docker:$n:missing"] = ['warning', "Container $n not found",
                "The watched container $n does not exist (check the name in the settings)."];
        }
    }
    $state['docker'] = $now;
}

function sm_check_docker_updated(array &$state, array &$events): void
{
    $imgs = sm_get_docker_images();
    if ($imgs === null) return;
    $prev = $state['docker_img'] ?? [];
    $now  = [];
    foreach ($imgs as $n => $c) {
        $p = $prev[$n] ?? null;
        $e = ['id' => $c['id'], 'image' => $c['image'], 'version' => $c['version'], 'updated' => $p['updated'] ?? null];
        if (is_array($p) && $p['id'] !== $c['id']) {          // new image for an existing container
            $e['updated'] = time();
            if (sm_norm_image((string)$p['image']) !== sm_norm_image($c['image'])) {
                $events[] = ['normal', "Container $n: image changed",
                    "Container $n now uses {$c['image']} instead of {$p['image']}."];
            } else {
                $ver = ($p['version'] !== '' || $c['version'] !== '')
                    ? sprintf(' Version: %s -> %s.', $p['version'] ?: '?', $c['version'] ?: '?') : '';
                $events[] = ['normal', "Container $n updated",
                    "Container $n was started with a new image ({$c['image']}).$ver"];
            }
        }
        $now[$n] = $e;
    }
    $state['docker_img'] = $now;
}

function sm_check_vms(array $cfg, array &$state, array &$issues, array &$events, array &$ran): void
{
    $list = sm_get_vms();
    if ($list === null) return;
    $ran[] = 'vm:';

    $watch = sm_list($cfg['VM_WATCH'] ?? '');
    $all   = in_array('*', $watch, true);
    $prev  = $state['vms'] ?? [];
    $now   = [];

    foreach ($list as ['name' => $vm, 'state' => $st]) {
        $now[$vm] = $st;
        if ($st === 'crashed') {
            $issues["vm:$vm:crashed"] = ['alert', "VM $vm crashed", "VM $vm is in state 'crashed'."];
        }
        if (!$all && in_array($vm, $watch, true) && $st !== 'running') {
            $issues["vm:$vm:down"] = ['alert', "VM $vm is not running", "Watched VM $vm is in state '$st'."];
        }
        if ($all && ($prev[$vm] ?? '') === 'running' && $st !== 'running') {
            $events[] = ['warning', "VM $vm stopped", "VM $vm is now in state '$st'."];
        }
    }
    $state['vms'] = $now;
}

function sm_check_system(array $cfg, array &$state, array &$issues, array &$events, array &$ran): void
{
    $ran[] = 'sys:';
    $s = sm_get_system();

    // detect a reboot (boot_id changes on every boot)
    if ($s['boot_id'] !== '') {
        if (isset($state['boot_id']) && $state['boot_id'] !== $s['boot_id']) {
            $events[] = ['warning', 'Server was restarted',
                sprintf('The server has been up for %d min. If the restart was not planned, check the syslog.', intdiv($s['uptime'], 60))];
        }
        $state['boot_id'] = $s['boot_id'];
    }

    $w = sm_num($cfg, 'CPU_LOAD_WARN', 90);
    if ($s['load_pct'] !== null && $s['load_pct'] >= $w) {
        $issues['sys:load'] = ['warning', 'High CPU load',
            sprintf('5-minute load %.2f on %d CPUs (%.0f %%, warning from %.0f %%).', $s['load'][1], $s['cores'], $s['load_pct'], $w)];
    }

    // note: the ZFS ARC counts as used here
    $w = sm_num($cfg, 'RAM_WARN', 90);
    if ($s['mem_pct'] !== null && $s['mem_pct'] >= $w) {
        $issues['sys:ram'] = ['warning', 'Memory running low',
            sprintf('%.1f %% used, available: %s.', $s['mem_pct'], sm_bytes((float)$s['mem_avail']))];
    }
}

function sm_check_ups(array &$issues, array &$ran): void
{
    $u = sm_get_ups();
    if ($u === null) return;
    $ran[] = 'ups:';
    $st     = $u['status'];
    $detail = sprintf('Status: %s, charge: %s, time left: %s.', $st, $u['charge'] ?: '?', $u['timeleft'] ?: '?');
    if (stripos($st, 'ONBATT') !== false) {
        $issues['ups:onbatt'] = ['alert', 'Power outage: UPS on battery', $detail];
    } elseif (stripos($st, 'COMMLOST') !== false) {
        $issues['ups:comm'] = ['warning', 'Lost connection to UPS', $detail];
    }
    if (stripos($st, 'REPLACEBATT') !== false) {
        $issues['ups:battery'] = ['warning', 'Replace UPS battery', $detail];
    }
}

function sm_check_certs(array $cfg, bool $force, array &$state, array &$issues, array &$ran): void
{
    global $dry;
    // certificates rarely change: check at most once per hour
    $stamp = SM_TMP . '/lastcert';
    if (!$force && time() - (int)@file_get_contents($stamp) < 3600 - 10) {
        sm_keep($state, $issues, 'cert:');
        return;
    }
    if (!$dry) file_put_contents($stamp, (string)time());

    $now    = time();
    $warn   = sm_num($cfg, 'CERT_WARN_DAYS', 20);
    $crit   = sm_num($cfg, 'CERT_CRIT_DAYS', 7);
    $ignore = array_map('strtolower', sm_list($cfg['CERT_IGNORE'] ?? ''));
    $items  = [];   // for the status page

    $grade = function (int $exp) use ($now, $warn, $crit): array {
        $days = (int)floor(($exp - $now) / 86400);
        if ($exp <= $now)    return [$days, 'alert', 'has expired'];
        if ($days <= $crit)  return [$days, 'alert', "expires in $days days"];
        if ($days <= $warn)  return [$days, 'warning', "expires in $days days"];
        return [$days, null, "valid, $days days left"];
    };

    // --- certificate files
    $fileCerts = [];
    $dirs = sm_list($cfg['CERT_DIRS'] ?? '');
    if ($dirs) {
        $ran[] = 'cert:file:';
        $res   = sm_get_cert_files($dirs);
        foreach ($res['missing'] as $d) {
            $issues["cert:file:missing:$d"] = ['warning', 'Certificate directory not found',
                "The directory $d does not exist. Check the path in the settings (CERT_DIRS)."];
        }
        // Detect superseded certificates: another certificate covers all names and expires later.
        // When a certificate is recreated, NPM creates a new npm-<id> directory; the old one may remain.
        $valid = array_filter($res['certs'], fn($x) => !isset($x['error']));
        $supersededBy = function (array $c) use ($valid): ?string {
            foreach ($valid as $o) {
                if ($o['id'] === $c['id'] || $o['expires'] <= $c['expires']) continue;
                $all = true;
                foreach ($c['names'] as $n) { if (!sm_cert_covers($o['names'], $n)) { $all = false; break; } }
                if ($all && $c['names']) return $o['id'];
            }
            return null;
        };
        foreach ($res['certs'] as $c) {
            $label = isset($c['names'][0]) ? $c['names'][0] : $c['id'];
            if (isset($c['error'])) {
                $issues["cert:file:{$c['id']}"] = ['warning', "Certificate $label not readable", "File: {$c['path']}"];
                $items[] = ['source' => 'File', 'name' => $label, 'id' => $c['id'], 'error' => $c['error']];
                continue;
            }
            if (array_intersect(array_map('strtolower', $c['names']), $ignore)) continue;
            $fileCerts[] = $c;
            $newer = $supersededBy($c);
            if ($newer !== null) {
                $items[] = ['source' => 'File', 'name' => $label, 'id' => $c['id'], 'names' => $c['names'],
                            'issuer' => $c['issuer'], 'expires' => $c['expires'],
                            'days' => (int)floor(($c['expires'] - $now) / 86400), 'level' => null,
                            'superseded' => $newer];
                continue;
            }
            [$days, $lvl, $txt] = $grade($c['expires']);
            if ($lvl !== null) {
                $issues["cert:file:{$c['id']}"] = [$lvl, "Certificate $label $txt",
                    sprintf('Certificate for %s (%s, issuer %s) valid until %s. Let\'s Encrypt normally renews 30 days before expiry; check the renewal in Nginx Proxy Manager.',
                        implode(', ', $c['names']), $c['id'], $c['issuer'] ?: '?', date('Y-m-d H:i', $c['expires']))];
            }
            $items[] = ['source' => 'File', 'name' => $label, 'id' => $c['id'], 'names' => $c['names'],
                        'issuer' => $c['issuer'], 'expires' => $c['expires'], 'days' => $days, 'level' => $lvl];
        }
    }

    // --- served certificates
    $hosts = sm_list($cfg['CERT_HOSTS'] ?? '');
    if ($hosts) {
        $ran[] = 'cert:live:';
        foreach ($hosts as $entry) {
            $r = sm_get_cert_live($entry);
            $h = $r['host'];
            if ($r['error'] !== null) {
                $hint = $r['addr'] === $h
                    ? " If the server cannot reach its public address (no NAT loopback on the router), enter it as $h@<LAN-IP>:<NPM-HTTPS-port>."
                    : ' Is Nginx Proxy Manager running and is the port correct?';
                $issues["cert:live:$h:conn"] = ['warning', "TLS check for $h failed", $r['error'] . '.' . $hint];
                $items[] = ['source' => 'Live', 'name' => $h, 'error' => $r['error']];
                continue;
            }
            [$days, $lvl, $txt] = $grade($r['expires']);
            if ($lvl !== null) {
                $issues["cert:live:$h:expiry"] = [$lvl, "Served certificate for $h $txt",
                    sprintf('%s:%d serves a certificate (issuer %s) valid until %s.',
                        $r['addr'], $r['port'], $r['issuer'] ?: '?', date('Y-m-d H:i', $r['expires']))];
            }
            $verr = null;
            if (sm_on($cfg, 'CERT_VERIFY') && $r['verify'] !== null && $r['verify']['code'] !== 0) {
                $verr = $r['verify']['text'];
                $issues["cert:live:$h:verify"] = ['warning', "Certificate for $h not trusted",
                    "Verification reports: $verr (code {$r['verify']['code']}). Causes: wrong hostname, missing intermediate certificates or a self-signed certificate."];
            }
            // compare with the file: is nginx still serving an older certificate?
            $stale = false;
            foreach ($fileCerts as $fc) {
                if (sm_cert_covers($fc['names'], $h) && $fc['expires'] > $r['expires'] + 86400) {
                    $stale = true;
                    $issues["cert:live:$h:stale"] = ['warning', "Outdated certificate served for $h",
                        sprintf('A certificate valid until %s exists on disk, but one valid until %s is being served. Nginx Proxy Manager probably did not load the renewal; restart the container.',
                            date('Y-m-d', $fc['expires']), date('Y-m-d', $r['expires']))];
                    break;
                }
            }
            $items[] = ['source' => 'Live', 'name' => $h, 'names' => $r['names'], 'issuer' => $r['issuer'],
                        'expires' => $r['expires'], 'days' => $days, 'level' => $lvl,
                        'verify' => $verr, 'stale' => $stale];
        }
    }

    if (!$dry) {
        @file_put_contents(SM_TMP . '/certs.json',
            json_encode(['time' => $now, 'items' => $items], JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE));
    }
}

/**
 * External checks via UptimeRobot: keeps the monitors from EXT_MONITORS in sync (create/delete, only monitors
 * tagged "srvmon" are deleted) and reports every monitor of the account that is DOWN.
 */
function sm_check_external(array $cfg, array &$state, array &$issues, array &$events, array &$ran): void
{
    global $dry;
    $key = trim((string)($cfg['UPTIMEROBOT_KEY'] ?? ''));
    if ($key === '') return;
    $failFile = SM_TMP . '/ext_fail';   // RAM: consecutive API failures

    // --- configuration
    $want = [];
    $invalid = false;
    foreach (sm_list($cfg['EXT_MONITORS'] ?? '') as $entry) {
        $e = sm_parse_ext($entry);
        if ($e === null) {
            $invalid = true;   // a typo must not delete the monitor of that entry
            $issues['ext:cfg:' . $entry] = ['warning', 'External check: invalid entry',
                "The entry '$entry' in EXT_MONITORS could not be read. Format: [nextcloud:|immich:]https://host/path[@LAN-IP:port]."];
            continue;
        }
        $want[$e['def']] = $e;
    }
    // same name twice (e.g. two Nextcloud instances): add the host
    $cnt = array_count_values(array_column($want, 'name'));
    foreach ($want as &$e) if ($cnt[$e['name']] > 1 && $e['name'] !== $e['host']) $e['name'] .= " ({$e['host']})";
    unset($e);

    // --- read monitors
    $err = null; $code = null;
    $mons = sm_ur_monitors($key, $err, $code);
    if ($mons === null) {
        sm_keep($state, $issues, 'ext:mon:');                 // keep known outages, decide nothing
        if ($code === 401 || $code === 403) {
            $issues['ext:api'] = ['warning', 'External check: API key rejected',
                "UptimeRobot rejected the API key ($err). Check UPTIMEROBOT_KEY in the settings."];
        } else {
            $n = (int)@file_get_contents($failFile) + 1;
            if (!$dry) @file_put_contents($failFile, (string)$n);
            if ($n >= 3) {
                $issues['ext:api'] = ['warning', 'External check: UptimeRobot not reachable',
                    "The UptimeRobot API could not be reached $n times in a row ($err). Is the internet connection down?"];
            } else {
                sm_keep($state, $issues, 'ext:api');
            }
        }
        return;
    }
    if (!$dry) @unlink($failFile);
    $ran[] = 'ext:';

    // --- sync: match by remembered ID first, then by definition (URL, type, keyword)
    $ids     = $state['ext_ids'] ?? [];                       // def => monitor ID created by srvmon
    $byId    = [];
    foreach ($mons as $m) $byId[(string)($m['id'] ?? '')] = $m;
    $matched = [];                                            // monitor ID => def
    foreach ($want as $def => $e) {
        $id = (string)($ids[$def] ?? '');
        if ($id === '' || !isset($byId[$id])) {
            $id = '';
            foreach ($mons as $m) if (sm_ext_def($m) === $def && !isset($matched[(string)$m['id']])) { $id = (string)$m['id']; break; }
        }
        if ($id !== '') { $matched[$id] = $def; $ids[$def] = $id; }
    }
    $created = 0;
    foreach ($want as $def => $e) {
        if (in_array($def, $matched, true)) continue;
        if ($created >= 5) break;                             // safety net against creation loops
        $created++;
        $body = ['type' => $e['keyword'] !== '' ? 'KEYWORD' : 'HTTP', 'friendlyName' => $e['name'], 'url' => $e['url'],
                 'interval' => 300, 'timeout' => 30, 'tagNames' => [SM_UR_TAG]];
        if ($e['keyword'] !== '') $body += ['keywordType' => 'ALERT_NOT_EXISTS', 'keywordCaseType' => 'CaseSensitive', 'keywordValue' => $e['keyword']];
        if ($dry) { echo "[dry-run] would create UptimeRobot monitor: {$e['url']}\n"; continue; }
        [$c, $j, $cerr] = sm_ur($key, 'POST', '/monitors', $body);
        if (($c === 200 || $c === 201) && isset($j['id'])) {
            $ids[$def] = (string)$j['id'];
            $mons[] = $j + ['status' => 'STARTED'];
            $matched[(string)$j['id']] = $def;
            $events[] = ['normal', "External check created: {$e['name']}",
                "srvmon created the UptimeRobot monitor for {$e['url']}. The first result follows within 5 minutes."];
        } else {
            $issues['ext:cfg:' . $e['url']] = ['warning', 'External check: monitor could not be created',
                "Creating the UptimeRobot monitor for {$e['url']} failed (" . ($cerr !== '' ? $cerr : "HTTP $c" . (isset($j['message']) ? ': ' . $j['message'] : '')) . ').'];
        }
    }
    // delete monitors created by srvmon that are no longer configured
    $known = array_flip(array_values($ids));
    foreach ($mons as $i => $m) {
        $id  = (string)($m['id'] ?? '');
        $own = isset($known[$id]) || in_array(SM_UR_TAG, array_column((array)($m['tags'] ?? []), 'name'), true);
        if (!$own || isset($matched[$id]) || $invalid) continue;
        if ($dry) { echo "[dry-run] would delete UptimeRobot monitor: " . ($m['url'] ?? $id) . "\n"; continue; }
        [$c] = sm_ur($key, 'DELETE', '/monitors/' . rawurlencode($id));
        if ($c >= 200 && $c < 300) {
            unset($mons[$i]);
            $events[] = ['normal', 'External check removed: ' . ($m['friendlyName'] ?? $id),
                'srvmon deleted the UptimeRobot monitor for ' . ($m['url'] ?? '?') . ', because it is no longer configured.'];
        }
    }
    $state['ext_ids'] = array_intersect_key($ids, $want);

    // --- evaluate all monitors of the account
    $items = [];
    foreach ($mons as $m) {
        $id     = (string)($m['id'] ?? '');
        $name   = (string)($m['friendlyName'] ?? $id);
        $st     = strtoupper((string)($m['status'] ?? ''));
        $e      = isset($matched[$id]) ? $want[$matched[$id]] : null;
        $item   = ['name' => $e['name'] ?? $name, 'url' => (string)($m['url'] ?? ''), 'status' => $st, 'managed' => $e !== null];
        if ($st === 'DOWN') {
            $name   = $e['name'] ?? $name;
            $inc    = is_array($m['lastIncident'] ?? null) ? $m['lastIncident'] : [];
            $t      = strtotime((string)($inc['startedAt'] ?? '')) ?: null;
            $reason = trim((string)($inc['reason'] ?? ''));
            $desc   = $t !== null
                ? sprintf('UptimeRobot reports %s as down since %s (%s).', $item['url'], date('Y-m-d H:i', $t), $reason !== '' ? $reason : '?')
                : "UptimeRobot reports {$item['url']} as down.";
            if ($e !== null && $e['local'] !== '') {
                [$ok, $res] = sm_ext_local($e);
                $desc .= $ok
                    ? " Local check OK ($res): the problem is probably on the way from the internet (DynDNS, router port forwarding, IPv6)."
                    : " Local check failed ($res): the problem is in Nginx Proxy Manager or the application.";
                $item['local'] = $res;
            }
            $issues["ext:mon:$id"] = ['alert', "$name not reachable from the internet", $desc];
            $item += ['since' => $t, 'reason' => $reason];
        }
        $items[] = $item;
    }
    if (!$dry) {
        @file_put_contents(SM_TMP . '/ext.json', json_encode(['time' => time(), 'items' => $items],
            JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE));
    }
}

function sm_check_updates(array &$state, array &$events): void
{
    $avail = sm_get_updates();
    if ($avail === null) return;
    $new = array_values(array_diff($avail, $state['updates'] ?? []));
    if ($new) {
        // map images to containers so the notification names the containers
        $items = [];
        foreach ($new as $img) {
            $names = [];
            foreach ($state['docker_img'] ?? [] as $n => $c) {
                if (sm_norm_image((string)$c['image']) === sm_norm_image($img)) $names[] = $n;
            }
            $items[] = $names ? implode(', ', $names) . " ($img)" : $img;
        }
        $events[] = ['normal', count($new) . ' Docker update(s) available',
            implode('; ', $items) . '. Update via the Docker tab.'];
    }
    $state['updates'] = $avail;
}

/** Reports every new Unraid OS version once. Versions ignored in the Update OS dialog are skipped. */
function sm_check_os_update(array &$state, array &$events): void
{
    $u = sm_get_os_update();
    if ($u === null || $u['error'] !== null) return;   // no or failed check: keep the last state
    $ver = ($u['version'] !== null && !$u['ignored']) ? $u['version'] : '';
    if ($ver !== '' && $ver !== ($state['os_update'] ?? '')) {
        $desc = $u['eligible']
            ? "Installed: {$u['current']}. Update via Tools > Update OS; read the release notes first."
            : "Installed: {$u['current']}. Not eligible: the update period of the license has ended"
              . ($u['update_exp'] !== '' ? " ({$u['update_exp']})" : '') . '. Extend the license to install this version.';
        $events[] = ['normal', "Unraid OS $ver available", $desc];
    }
    $state['os_update'] = $ver;
}

/** Reports every new plugin version once, all plugins of a run in one notification. */
function sm_check_plugin_updates(array &$state, array &$events): void
{
    $p = sm_get_plugin_updates();
    if ($p === null) return;
    $prev  = $state['plugin_updates'] ?? [];
    $now   = [];
    $items = [];
    foreach ($p['updates'] as $name => $v) {
        $now[$name] = $v['available'];
        if (($prev[$name] ?? '') !== $v['available']) $items[] = "$name {$v['installed']} -> {$v['available']}";
    }
    if ($items) {
        $events[] = ['normal', count($items) . ' plugin update(s) available',
            implode('; ', $items) . '. Update via the Plugins tab.'];
    }
    $state['plugin_updates'] = $now;
}

/**
 * Reports performed plugin updates (installed version changed), all plugins of a run in one notification.
 * Newly installed plugins have no previous version and are not reported. Plugins missing in this run
 * (e.g. still being installed during boot) lose their baseline, so no false report is possible.
 */
function sm_check_plugin_updated(array &$state, array &$events): void
{
    $list = sm_get_plugins();
    if ($list === null) return;
    $prev  = $state['plugins'] ?? [];
    $now   = [];
    $items = [];
    foreach ($list as $name => $ver) {
        $p = $prev[$name] ?? null;
        $e = ['version' => $ver, 'updated' => $p['updated'] ?? null];
        if (is_array($p) && (string)$p['version'] !== $ver) {
            $e['updated'] = time();
            $items[$name] = "$name {$p['version']} -> $ver";
        }
        $now[$name] = $e;
    }
    if (count($items) === 1) {
        $events[] = ['normal', 'Plugin ' . array_key_first($items) . ' updated', 'Plugin updated: ' . reset($items) . '.'];
    } elseif ($items) {
        $events[] = ['normal', count($items) . ' plugins updated', implode('; ', $items) . '.'];
    }
    $state['plugins'] = $now;
}

// ================================================================== Helpers

function sm_send(string $lvl, string $subj, string $desc, bool $forceHook = false): void
{
    global $dry, $cfg, $smHookSent, $smHookSkipped;
    $url  = trim((string)($cfg['WEBHOOK_URL'] ?? ''));
    $hook = $url !== '' && ($forceHook || sm_rank($lvl) >= sm_rank((string)($cfg['WEBHOOK_LEVEL'] ?? 'warning')));
    $nl   = sm_lang($cfg, 'NOTIFY_LANG');    // Unraid notification
    $wl   = sm_lang($cfg, 'WEBHOOK_LANG');   // webhook; the syslog always stays English
    $host  = gethostname() ?: 'Unraid';
    $intro = ['alert' => 'Alert', 'warning' => 'Warning'][$lvl] ?? 'Notice';
    $speech = "$intro from server $host: $subj";
    if ($dry) {
        echo "[$lvl] $subj - $desc" . ($hook ? ' [+Webhook]' : '') . "\n";
        if ($nl !== 'en') echo "    Unraid ($nl): " . sm_tr($subj, $nl) . ' - ' . sm_tr($desc, $nl) . "\n";
        if ($hook && $wl !== 'en') echo "    Webhook ($wl): " . sm_tr($speech, $wl) . "\n";
        return;
    }

    exec(SM_NOTIFY
        . ' -e ' . escapeshellarg('Server Monitor')
        . ' -s ' . escapeshellarg('srvmon: ' . sm_tr($subj, $nl))
        . ' -d ' . escapeshellarg(sm_tr($desc, $nl))
        . ' -i ' . escapeshellarg($lvl)
        . ' >/dev/null 2>&1');
    exec('logger -t srvmon ' . escapeshellarg("[$lvl] $subj - $desc"));

    if (!$hook) return;
    if ((int)$smHookSent >= SM_MAX_HOOKS) { $smHookSkipped = (int)$smHookSkipped + 1; return; }
    $smHookSent = (int)$smHookSent + 1;
    sm_webhook($url, [
        'level' => $lvl, 'subject' => sm_tr($subj, $wl), 'description' => sm_tr($desc, $wl),
        'speech' => sm_tr($speech, $wl), 'lang' => $wl,
        'host' => $host, 'time' => time(),
    ]);
}

/** After sending: summarise skipped webhook notifications in one call. */
function sm_webhook_flush(): void
{
    global $dry, $cfg, $smHookSkipped;
    if ($dry || (int)$smHookSkipped === 0) return;
    $host = gethostname() ?: 'Unraid';
    $wl   = sm_lang($cfg, 'WEBHOOK_LANG');
    sm_webhook(trim((string)$cfg['WEBHOOK_URL']), [
        'level' => 'warning', 'subject' => sm_tr("$smHookSkipped more notifications", $wl),
        'description' => sm_tr('Details in the Unraid notifications.', $wl),
        'speech' => sm_tr("Server $host has $smHookSkipped more notifications. Details in Unraid.", $wl),
        'lang' => $wl, 'host' => $host, 'time' => time(),
    ]);
}

function sm_webhook(string $url, array $payload): void
{
    $json = json_encode($payload, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES);
    $out = []; $rc = 0;
    exec('curl -fsS -m 10 -X POST -H ' . escapeshellarg('Content-Type: application/json')
         . ' --data-binary ' . escapeshellarg((string)$json) . ' ' . escapeshellarg($url) . ' 2>&1', $out, $rc);
    if ($rc !== 0) {
        // webhook target unreachable (e.g. Home Assistant stopped): log only,
        // the Unraid notification has already been sent.
        exec('logger -t srvmon ' . escapeshellarg('Webhook failed (curl ' . $rc . '): ' . implode(' ', $out)));
    }
}

function sm_keep(array $state, array &$issues, string $prefix): void
{
    foreach ($state['issues'] ?? [] as $k => $p) {
        if (strncmp((string)$k, $prefix, strlen($prefix)) === 0) {
            $issues[$k] = [(string)$p['level'], (string)$p['subject'], (string)$p['desc']];
        }
    }
}

function sm_prefix_ran(string $key, array $ran): bool
{
    foreach ($ran as $p) if (strncmp($key, $p, strlen($p)) === 0) return true;
    return false;
}

function sm_rank(string $l): int
{
    return ['normal' => 0, 'warning' => 1, 'alert' => 2][$l] ?? 0;
}
]]></INLINE>
</FILE>

<FILE Name="&emhttp;/srvmon.page">
<INLINE><![CDATA[Menu="Utilities"
Title="Server Monitor"
Icon="heartbeat"
---
<?php
$sm = array_merge(
    @parse_ini_file('/usr/local/emhttp/plugins/srvmon/default.cfg') ?: [],
    @parse_ini_file('/boot/config/plugins/srvmon/srvmon.cfg') ?: []
);
$smStatus = json_decode((string)@file_get_contents('/tmp/srvmon/status.json'), true) ?: [];
require_once '/usr/local/emhttp/plugins/srvmon/include/lang.php';
if (!function_exists('sm_v')) {
    function sm_langsel(array $c, string $k): string {
        $cur = (string)($c[$k] ?? 'en');
        $o = '';
        foreach (SM_LANGS as $v => $t) {
            $o .= '<option value="' . $v . '"' . ($cur === $v ? ' selected' : '') . '>' . htmlspecialchars($t) . '</option>';
        }
        return '<select name="' . $k . '">' . $o . '</select>';
    }
    function sm_v(array $c, string $k): string {
        return htmlspecialchars((string)($c[$k] ?? ''), ENT_QUOTES);
    }
    function sm_lvl(array $c, string $k): string {
        $cur = (string)($c[$k] ?? 'warning');
        $o = '';
        foreach (['normal' => 'Everything (from Notice)', 'warning' => 'Warnings and alerts', 'alert' => 'Alerts only'] as $v => $t) {
            $o .= '<option value="' . $v . '"' . ($cur === $v ? ' selected' : '') . '>' . $t . '</option>';
        }
        return '<select name="' . $k . '">' . $o . '</select>';
    }
    function sm_yn(array $c, string $k): string {
        $on = in_array(strtolower((string)($c[$k] ?? '')), ['1', 'yes', 'true', 'on'], true);
        return '<select name="' . $k . '">'
             . '<option value="yes"' . ($on ? ' selected' : '') . '>Yes</option>'
             . '<option value="no"'  . ($on ? '' : ' selected') . '>No</option></select>';
    }
}
?>
<style>
.srvmon-sec{font-weight:bold;font-size:1.1em;margin:2.2em 0 .9em;padding-bottom:.35em;border-bottom:1px solid rgba(127,127,127,.4)}
.srvmon-sec.first{margin-top:.5em}
.srvmon-sec small{font-weight:normal;opacity:.7;margin-left:.6em}
</style>
<div style="margin:0 0 1.5em 0">
<p><b>Last run:</b> <?= isset($smStatus['lastrun']) ? date('Y-m-d H:i:s', (int)$smStatus['lastrun']) : 'none yet' ?></p>
<?php if (empty($smStatus['issues'])): ?>
<p>No active problems.</p>
<?php else: ?>
<table class="tablesorter"><thead><tr><th>Level</th><th>Problem</th><th>Since</th></tr></thead><tbody>
<?php foreach ($smStatus['issues'] as $i): ?>
<tr><td><?= htmlspecialchars((string)$i['level']) ?></td><td><?= htmlspecialchars((string)$i['subject']) ?><br><small><?= htmlspecialchars((string)$i['desc']) ?></small></td><td><?= date('Y-m-d H:i', (int)$i['since']) ?></td></tr>
<?php endforeach; ?>
</tbody></table>
<?php endif; ?>
<p><small>Emails are sent by Unraid's notification system. Configure SMTP and the email agents per level under Settings &gt; Notifications. Update notifications have the level Notice: to receive them by email, enable the email agent for Notices there. Available Docker, Unraid OS and plugin updates come from Unraid's own update checks; their schedules are also set under Settings &gt; Notifications.</small></p>
</div>

<form markdown="1" name="srvmon_settings" method="POST" action="/update.php" target="progressFrame">
<input type="hidden" name="#file" value="srvmon/srvmon.cfg">
<input type="hidden" name="csrf_token" value="<?=htmlspecialchars((string)($var['csrf_token'] ?? ''), ENT_QUOTES)?>">

<div class="srvmon-sec first">General</div>

Check interval (minutes):
: <input type="number" name="INTERVAL" min="1" max="1440" value="<?=sm_v($sm,'INTERVAL')?>">

Reminder for ongoing problems (hours, 0 = off):
: <input type="number" name="REMIND_HOURS" min="0" value="<?=sm_v($sm,'REMIND_HOURS')?>" style="width:6em">

Notify when a problem is resolved:
: <?=sm_yn($sm,'NOTIFY_RESOLVED')?>

Language of Unraid notifications:
: <?=sm_langsel($sm,'NOTIFY_LANG')?>

<div class="srvmon-sec">Disks and SMART</div>

Check disks (status, errors, temperature):
